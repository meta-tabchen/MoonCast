+func TestLegacyAudioAuthenticatedPCMToALACRTPAndClose(t *testing.T) {
+	tcp, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer tcp.Close()
+	data, e := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer data.Close()
+	ctrl, e := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer ctrl.Close()
+	timing, e := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if e != nil {
+		t.Fatal(e)
+	}
