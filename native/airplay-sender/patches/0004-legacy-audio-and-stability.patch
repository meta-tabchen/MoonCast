+	}
+	scale := float32(dw) / float32(w)
+	if other := float32(dh) / float32(h); other < scale {
+		scale = other
+	}
+	outW, outH := float32(w)*scale, float32(h)*scale
+	return (float32(dw) - outW) / 2, (float32(dh) - outH) / 2, outW, outH
