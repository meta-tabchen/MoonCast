+func TestLegacyWriteDeadline(t *testing.T) {
+	sender, receiver := net.Pipe()
+	defer receiver.Close()
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: sender}, closed: make(chan struct{}), started: time.Now()}
+	defer m.Close()
+	start := time.Now()
+	m.mu.Lock()
+	err := m.packet(2, nil)
+	m.mu.Unlock()
+	if err == nil || time.Since(start) > 4*time.Second {
+		t.Fatalf("blocked write not bounded: %v", err)
+	}
+}
