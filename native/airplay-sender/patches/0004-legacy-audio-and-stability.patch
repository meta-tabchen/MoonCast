+	server := make(chan error, 1)
+	go func() {
+		c, e := tcp.Accept()
+		if e != nil {
+			server <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(12 * time.Second))
+		r := bufio.NewReader(c)
+		for _, want := range []string{"OPTIONS", "ANNOUNCE", "ANNOUNCE", "SETUP", "RECORD", "SET_PARAMETER", "OPTIONS"} {
+			method, h, b, e := readRAOPTest(r)
+			if e != nil {
+				server <- e
+				return
+			}
+			if method != want {
+				server <- fmt.Errorf("method %s want %s", method, want)
+				return
+			}
+			if method == "ANNOUNCE" && h["authorization"] == "" {
+				replyRAOPTest(c, 401, "WWW-Authenticate: Digest realm=\"raop\", nonce=\"fixture\", qop=\"auth\"\r\n")
+				continue
+			}
+			if method == "ANNOUNCE" {
+				p := parseDigestParams(h["authorization"])
+				ha1 := md5Hex("iTunes:raop:test-password")
+				ha2 := md5Hex(method + ":" + p["uri"])
+				want := md5Hex(ha1 + ":fixture:" + p["nc"] + ":" + p["cnonce"] + ":auth:" + ha2)
+				if p["username"] != "iTunes" || p["nc"] != "00000001" || p["response"] != want || !bytes.Contains(b, []byte("AppleLossless")) {
+					server <- fmt.Errorf("bad auth/SDP")
+					return
+				}
+			}
+			if method == "SETUP" {
+				if !strings.Contains(h["transport"], fmt.Sprintf("timing_port=%d", timing.LocalAddr().(*net.UDPAddr).Port)) {
+					server <- fmt.Errorf("wrong timing socket")
+					return
+				}
+				replyRAOPTest(c, 200, fmt.Sprintf("Session: fixture-session\r\nTransport: RTP/AVP/UDP;server_port=%d;control_port=%d\r\n", data.LocalAddr().(*net.UDPAddr).Port, ctrl.LocalAddr().(*net.UDPAddr).Port))
+				continue
+			}
+			if method == "RECORD" && h["rtp-info"] != "seq=1;rtptime=2205" {
+				server <- fmt.Errorf("missing RTP origin")
+				return
+			}
+			if method == "SET_PARAMETER" && !bytes.Equal(b, []byte("volume: 0.000000\r\n")) {
+				server <- fmt.Errorf("bad volume")
+				return
+			}
+			if method == "OPTIONS" && h["session"] != "" {
+				server <- nil
+				return
+			} // close receiver during keepalive
+			replyRAOPTest(c, 200, "")
+		}
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	m := &LegacyHTTPMirror{client: &AirPlayClient{host: "127.0.0.1"}, timing: timing, started: time.Now(), deviceID: 7, firstFrame: make(chan struct{})}
+	a, e := m.setupAudioEndpoint(ctx, "test-password", legacyAudioEndpoint{tcp.Addr().(*net.TCPAddr).Port, "0,1,2", "0"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer a.Close()
+	capture, w := NewPipeAudioCapture()
+	defer StopPipeAudioCapture(capture, w)
+	run := make(chan error, 1)
+	go func() { run <- a.Run(capture) }()
+	data.SetReadDeadline(time.Now().Add(80 * time.Millisecond))
+	var packet [4096]byte
+	if _, _, e = data.ReadFromUDP(packet[:]); e == nil {
+		t.Fatal("audio before first video")
+	}
+	close(m.firstFrame)
+	pcm := make([]byte, 1408)
+	for i := 0; i < 704; i++ {
+		binary.LittleEndian.PutUint16(pcm[i*2:], uint16(int16(i*83-27000)))
+	}
+	sent := make(chan struct{})
+	go func() {
+		defer close(sent)
+		ticker := time.NewTicker(8 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				if _, e := w.Write(pcm); e != nil {
+					return
+				}
+			}
+		}
+	}()
+	var frames atomic.Int32
+	received := make(chan error, 1)
+	go func() {
+		var last uint32
+		for {
+			data.SetReadDeadline(time.Now().Add(7 * time.Second))
+			n, _, e := data.ReadFromUDP(packet[:])
+			if e != nil {
+				received <- nil
+				return
+			}
+			if n < 12+8 || packet[1]&0x7f != 96 {
+				received <- fmt.Errorf("bad RTP")
+				return
+			}
+			rtp := binary.BigEndian.Uint32(packet[4:8])
+			if rtp < last {
+				continue
+			}
+			last = rtp
+			// Decode the independently specified ALAC verbatim bitstream. Sample bits
+			// start at bit 55; stereo channels are interleaved, big-endian in the stream.
+			payload := packet[12:n]
+			if !bytes.Equal(payload[:6], []byte{0x20, 0, 0x12, 0, 0, 2}) || payload[6]&0xfe != 0xc0 {
+				received <- fmt.Errorf("bad ALAC header")
+				return
+			}
+			for i := 0; i < 704; i++ {
+				var sample uint16
+				for bit := 0; bit < 16; bit++ {
+					pos := 55 + i*16 + bit
+					sample = sample<<1 | uint16((payload[pos/8]>>uint(7-pos%8))&1)
+				}
+				if sample != binary.LittleEndian.Uint16(pcm[i*2:]) {
+					received <- fmt.Errorf("PCM changed at sample %d", i)
+					return
+				}
+			}
+			frames.Add(1)
+		}
+	}()
+	select {
+	case e = <-run:
+		if e == nil {
+			t.Error("close should end audio")
+		}
+	case <-time.After(9 * time.Second):
+		t.Fatal("audio keepalive failed to detect closed receiver")
+	}
+	cancel()
+	a.Close()
+	w.Close()
+	data.Close()
+	<-sent
+	if e = <-received; e != nil {
+		t.Fatal(e)
+	}
+	if e = <-server; e != nil {
+		t.Fatal(e)
+	}
+	if frames.Load() < 400 {
+		t.Fatalf("too few audio packets: %d", frames.Load())
+	}
+	t.Logf("decoded %d RTP ALAC frames byte-for-byte to captured PCM; receiver closure propagated", frames.Load())
+}
