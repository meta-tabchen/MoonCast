+func acceptLegacyMirror(c net.Conn) (*bufio.Reader, error) {
+	r := bufio.NewReader(c)
+	req, _, err := legacyReadRequest(r)
+	if err != nil {
+		return nil, err
+	}
+	if req.URL.Path != "/stream.xml" {
+		return nil, fmt.Errorf("missing probe")
+	}
+	legacyTestReply(c, 200, legacyCaps(), "")
+	req, _, err = legacyReadRequest(r)
+	if err != nil {
+		return nil, err
+	}
+	if req.URL.Path != "/fp-setup" {
+		return nil, fmt.Errorf("missing FairPlay negotiation")
+	}
+	legacyTestReply(c, 501, nil, "")
+	req, _, err = legacyReadRequest(r)
+	if err != nil {
+		return nil, err
+	}
+	if req.URL.Path != "/stream" {
+		return nil, fmt.Errorf("missing stream upgrade")
+	}
+	return r, nil
+}
