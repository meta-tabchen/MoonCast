+package airplay
+
+// Independent RAOP sender. Wire references: https://nto.github.io/AirPlay.html#audio
+// Discovery is restricted to the selected receiver IP; no port scanning/fallback
+// to an unadvertised encryption mode or microphone capture is permitted.
+import (
+	"bufio"
+	"context"
+	"encoding/base64"
+	"fmt"
+	"github.com/grandcat/zeroconf"
+	"io"
+	"net"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+type legacyAudioEndpoint struct {
+	port               int
+	codecs, encryption string
+}
+
+func legacyAudioEndpointFor(ctx context.Context, host string) (legacyAudioEndpoint, error) {
+	ifaces, traffic, err := airPlayMDNSInterfaces()
+	if err != nil || len(ifaces) == 0 {
+		return legacyAudioEndpoint{}, fmt.Errorf("RAOP discovery unavailable")
+	}
+	resolver, err := zeroconf.NewResolver(zeroconf.SelectIfaces(ifaces), zeroconf.SelectIPTraffic(traffic))
+	if err != nil {
+		return legacyAudioEndpoint{}, err
+	}
+	query, cancel := context.WithTimeout(ctx, 1800*time.Millisecond)
+	defer cancel()
+	entries := make(chan *zeroconf.ServiceEntry, 16)
+	if err = resolver.Browse(query, "_raop._tcp", "local.", entries); err != nil {
+		return legacyAudioEndpoint{}, err
+	}
+	var found legacyAudioEndpoint
+	// Drain through cancellation: zeroconf may still be delivering entries when
+	// the selected peer is found. Never strand its worker on a channel send.
+	for entry := range entries {
+		same := false
+		for _, ip := range entry.AddrIPv4 {
+			same = same || ip.Equal(net.ParseIP(host))
+		}
+		if !same || entry.Port < 1 || entry.Port > 65535 {
+			continue
+		}
+		txt := map[string]string{}
+		for _, s := range entry.Text {
+			k, v, ok := strings.Cut(s, "=")
+			if ok {
+				txt[strings.ToLower(k)] = v
+			}
+		}
+		found = legacyAudioEndpoint{entry.Port, txt["cn"], txt["et"]}
+		cancel()
+	}
+	if found.port == 0 {
+		return found, fmt.Errorf("RAOP not advertised for selected receiver")
+	}
+	return found, nil
+}
+
+func legacyListContains(list, value string) bool {
+	for _, part := range strings.Split(list, ",") {
+		if strings.TrimSpace(part) == value {
+			return true
+		}
+	}
+	return false
+}
+
+type LegacyAudio struct {
+	conn                              net.Conn
+	reader                            *bufio.Reader
+	mu                                sync.Mutex
+	once                              sync.Once
+	cancel                            context.CancelFunc
+	ctx                               context.Context
+	seq                               int
+	nonceCount                        int
+	clientNonce                       string
+	uri, session, challenge, password string
+	deviceID                          uint64
+	stream                            *AudioStream
+	mirror                            *MirrorSession
+}
+
+func (m *LegacyHTTPMirror) SetupAudio(ctx context.Context, password string) (*LegacyAudio, error) {
+	endpoint, err := legacyAudioEndpointFor(ctx, m.client.host)
+	if err != nil {
+		return nil, err
+	}
+	return m.setupAudioEndpoint(ctx, password, endpoint)
+}
+
+func (m *LegacyHTTPMirror) setupAudioEndpoint(ctx context.Context, password string, endpoint legacyAudioEndpoint) (*LegacyAudio, error) {
+	if !legacyListContains(endpoint.codecs, "1") {
+		return nil, fmt.Errorf("RAOP ALAC not advertised")
+	}
+	// Prefer authenticated FairPlay where advertised. Plain transport is allowed
+	// only when the receiver explicitly lists et=0, never after an encryption failure.
+	encrypted := legacyListContains(endpoint.encryption, "4")
+	if !encrypted && !legacyListContains(endpoint.encryption, "0") {
+		return nil, fmt.Errorf("RAOP encryption unsupported")
+	}
+	child, cancel := context.WithCancel(ctx)
+	a := &LegacyAudio{ctx: child, cancel: cancel, password: password, deviceID: m.deviceID}
+	conn, err := (&net.Dialer{Timeout: 800 * time.Millisecond}).DialContext(child, "tcp", net.JoinHostPort(m.client.host, strconv.Itoa(endpoint.port)))
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	a.conn = conn
+	a.reader = bufio.NewReaderSize(conn, 4096)
+	context.AfterFunc(child, func() { conn.Close() })
+	if tcp, ok := conn.(*net.TCPConn); ok {
+		tcp.SetNoDelay(true)
+		tcp.SetKeepAlive(true)
+		tcp.SetKeepAlivePeriod(3 * time.Second)
+	}
+	keep := false
+	defer func() {
+		if !keep {
+			a.Close()
+		}
+	}()
+	// Entire optional setup is bounded, including malicious partial replies.
+	deadline := time.AfterFunc(5*time.Second, func() { conn.Close() })
+	defer deadline.Stop()
+	a.uri = fmt.Sprintf("rtsp://%s/%d", conn.LocalAddr().(*net.TCPAddr).IP.String(), m.deviceID)
+	if _, _, err = a.request("OPTIONS", "*", "", nil, nil); err != nil {
+		return nil, fmt.Errorf("RAOP OPTIONS: %w", err)
+	}
+	client := NewAirPlayClient(m.client.host, endpoint.port)
+	client.conn = conn
+	client.requestOverride = func(method, path, ct string, b []byte, extra ...map[string]string) ([]byte, error) {
+		hdr := map[string]string{}
+		for _, xs := range extra {
+			for k, v := range xs {
+				hdr[k] = v
+			}
+		}
+		data, _, e := a.request(method, path, ct, b, hdr)
+		return data, e
+	}
+	var aesKey, aesIV []byte
+	keySDP := ""
+	if encrypted {
+		client.infoUnavailable = true
+		if err = client.FairPlaySetup(child); err != nil {
+			return nil, fmt.Errorf("RAOP FairPlay: %w", err)
+		}
+		aesKey, aesIV = client.fpAesKey, client.fpIV
+		if len(aesKey) != 16 || len(aesIV) != 16 || len(client.FpEkey) != 72 {
+			return nil, fmt.Errorf("RAOP invalid encryption parameters")
+		}
+		keySDP = "a=fpaeskey:" + base64.RawStdEncoding.EncodeToString(client.FpEkey) + "\r\na=aesiv:" + base64.RawStdEncoding.EncodeToString(aesIV) + "\r\n"
+	}
+	localIP := conn.LocalAddr().(*net.TCPAddr).IP
+	sdp := fmt.Sprintf("v=0\r\no=AirTunes %d 0 IN IP4 %s\r\ns=AirTunes\r\nc=IN IP4 %s\r\nt=0 0\r\nm=audio 0 RTP/AVP 96\r\na=rtpmap:96 AppleLossless\r\na=fmtp:96 352 0 16 40 10 14 2 255 0 0 44100\r\n%sa=min-latency:2205\r\n", m.deviceID, localIP.String(), m.client.host, keySDP)
+	if _, _, err = a.request("ANNOUNCE", a.uri, "application/sdp", []byte(sdp), nil); err != nil {
+		return nil, fmt.Errorf("RAOP ANNOUNCE: %w", err)
+	}
+	ctrl, err := net.ListenUDP("udp", &net.UDPAddr{IP: localIP})
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if !keep {
+			ctrl.Close()
+		}
+	}()
+	data, err := net.ListenUDP("udp", &net.UDPAddr{IP: localIP})
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if !keep {
+			data.Close()
+		}
+	}()
+	transport := fmt.Sprintf("RTP/AVP/UDP;unicast;mode=record;control_port=%d;timing_port=%d", ctrl.LocalAddr().(*net.UDPAddr).Port, m.timing.LocalAddr().(*net.UDPAddr).Port)
+	_, headers, err := a.request("SETUP", a.uri, "", nil, map[string]string{"Transport": transport})
+	if err != nil {
+		return nil, fmt.Errorf("RAOP SETUP: %w", err)
+	}
+	ports := map[string]int{}
+	for _, part := range strings.Split(headers["transport"], ";") {
+		k, v, ok := strings.Cut(strings.TrimSpace(part), "=")
+		if ok {
+			n, _ := strconv.Atoi(v)
+			ports[k] = n
+		}
+	}
+	dp, cp := ports["server_port"], ports["control_port"]
+	if dp < 1 || dp > 65535 || cp < 1 || cp > 65535 {
+		return nil, fmt.Errorf("RAOP invalid transport ports")
+	}
+	a.session = strings.Split(headers["session"], ";")[0]
+	if a.session == "" {
+		return nil, fmt.Errorf("RAOP missing session")
+	}
+	a.mirror = &MirrorSession{client: client, firstFrameSent: m.firstFrame}
+	a.stream, err = a.mirror.setupAudioStream(dp, cp, aesKey, aesIV, nil, audioSecurityLegacyAES, 2, 2205, ctrl, data)
+	if err != nil {
+		return nil, err
+	}
+	a.stream.clock = func() uint64 { return legacyTimestamp(time.Since(m.started)) }
+	if _, _, err = a.request("RECORD", a.uri, "", nil, map[string]string{"Range": "npt=0-", "RTP-Info": "seq=1;rtptime=2205"}); err != nil {
+		return nil, fmt.Errorf("RAOP RECORD: %w", err)
+	}
+	if _, _, err = a.request("SET_PARAMETER", a.uri, "text/parameters", []byte("volume: 0.000000\r\n"), nil); err != nil {
+		return nil, fmt.Errorf("RAOP volume: %w", err)
+	}
+	conn.SetDeadline(time.Time{})
+	keep = true
+	return a, nil
+}
+
+func (a *LegacyAudio) request(method, uri, ct string, body []byte, extra map[string]string) ([]byte, map[string]string, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	for attempt := 0; attempt < 2; attempt++ {
+		a.seq++
+		headers := map[string]string{"CSeq": strconv.Itoa(a.seq), "User-Agent": "AirTunes/150.33", "X-Apple-Device-ID": fmt.Sprintf("0x%012x", a.deviceID)}
+		for k, v := range extra {
+			headers[k] = v
+		}
+		if a.session != "" {
+			headers["Session"] = a.session
+		}
+		if a.challenge != "" {
+			a.nonceCount++
+			value, e := legacyAudioDigest(a.challenge, method, uri, a.password, a.nonceCount, a.clientNonce)
+			if e != nil {
+				return nil, nil, e
+			}
+			headers["Authorization"] = value
+		}
+		if ct != "" {
+			headers["Content-Type"] = ct
+		}
+		var b strings.Builder
+		fmt.Fprintf(&b, "%s %s RTSP/1.0\r\nContent-Length: %d\r\n", method, uri, len(body))
+		for k, v := range headers {
+			if strings.ContainsAny(k+v, "\r\n") {
+				return nil, nil, fmt.Errorf("RAOP invalid header")
+			}
+			fmt.Fprintf(&b, "%s: %s\r\n", k, v)
+		}
+		b.WriteString("\r\n")
+		a.conn.SetDeadline(time.Now().Add(2 * time.Second))
+		if err := writeLegacyAll(a.conn, append([]byte(b.String()), body...)); err != nil {
+			return nil, nil, err
+		}
+		statusBytes, err := a.reader.ReadSlice('\n')
+		status := string(statusBytes)
+		if err != nil {
+			return nil, nil, err
+		}
+		fields := strings.Fields(status)
+		if len(fields) < 2 || (fields[0] != "RTSP/1.0" && fields[0] != "HTTP/1.1") {
+			return nil, nil, fmt.Errorf("RAOP invalid response")
+		}
+		code, _ := strconv.Atoi(fields[1])
+		resp := map[string]string{}
+		size := len(status)
+		for {
+			lineBytes, e := a.reader.ReadSlice('\n')
+			line := string(lineBytes)
+			if e != nil {
+				return nil, nil, e
+			}
+			size += len(line)
+			if size > 16384 {
+				return nil, nil, fmt.Errorf("RAOP response too large")
+			}
+			if line == "\r\n" {
+				break
+			}
+			k, v, ok := strings.Cut(line, ":")
+			if !ok {
+				return nil, nil, fmt.Errorf("RAOP malformed header")
+			}
+			key := strings.ToLower(strings.TrimSpace(k))
+			if _, dup := resp[key]; dup {
+				return nil, nil, fmt.Errorf("RAOP duplicate header")
+			}
+			resp[key] = strings.TrimSpace(v)
+		}
+		n := 0
+		if value, ok := resp["content-length"]; ok {
+			n, err = strconv.Atoi(value)
+			if err != nil || n < 0 || n > 65536 {
+				return nil, nil, fmt.Errorf("RAOP invalid body size")
+			}
+		}
+		data := make([]byte, n)
+		if _, err = io.ReadFull(a.reader, data); err != nil {
+			return nil, nil, err
+		}
+		if code == 401 && attempt == 0 {
+			if a.password == "" {
+				return nil, resp, ErrAirPlay1PasswordRequired
+			}
+			a.challenge = resp["www-authenticate"]
+			a.nonceCount, a.clientNonce = 0, randomHex(8)
+			if a.challenge == "" {
+				return nil, resp, fmt.Errorf("RAOP missing authentication challenge")
+			}
+			continue
+		}
+		if code < 200 || code >= 300 {
+			return nil, resp, &HTTPStatusError{StatusCode: code}
+		}
+		return data, resp, nil
+	}
+	return nil, nil, ErrAirPlay1PasswordRequired
+}
+
+func legacyAudioDigest(challenge, method, uri, password string, count int, clientNonce ...string) (string, error) {
+	if !strings.HasPrefix(strings.ToLower(challenge), "digest ") {
+		return "", fmt.Errorf("RAOP unsupported authentication")
+	}
+	p := parseDigestParams(challenge)
+	for _, k := range []string{"realm", "nonce"} {
+		if p[k] == "" || strings.ContainsAny(p[k], "\r\n\"\\") {
+			return "", fmt.Errorf("RAOP invalid challenge")
+		}
+	}
+	if alg := p["algorithm"]; alg != "" && !strings.EqualFold(alg, "MD5") {
+		return "", fmt.Errorf("RAOP unsupported digest algorithm")
+	}
+	ha1 := md5Hex("iTunes:" + p["realm"] + ":" + password)
+	ha2 := md5Hex(method + ":" + uri)
+	suffix := ""
+	response := md5Hex(ha1 + ":" + p["nonce"] + ":" + ha2)
+	if p["qop"] != "" {
+		if !legacyListContains(p["qop"], "auth") {
+			return "", fmt.Errorf("RAOP unsupported digest qop")
+		}
+		cn := randomHex(8)
+		if len(clientNonce) > 0 && clientNonce[0] != "" {
+			cn = clientNonce[0]
+		}
+		nc := fmt.Sprintf("%08x", count)
+		response = md5Hex(ha1 + ":" + p["nonce"] + ":" + nc + ":" + cn + ":auth:" + ha2)
+		suffix = fmt.Sprintf(", qop=auth, nc=%s, cnonce=\"%s\"", nc, cn)
+	}
+	return fmt.Sprintf("Digest username=\"iTunes\", realm=\"%s\", nonce=\"%s\", uri=\"%s\", response=\"%s\"%s", p["realm"], p["nonce"], uri, response, suffix), nil
+}
+
+func (a *LegacyAudio) Run(capture *AudioCapture) error {
+	defer a.Close()
+	go func() {
+		ticker := time.NewTicker(5 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-a.ctx.Done():
+				return
+			case <-ticker.C:
+				if _, _, err := a.request("OPTIONS", "*", "", nil, nil); err != nil {
+					a.Close()
+					capture.pcmPipe.Close()
+					return
+				}
+			}
+		}
+	}()
+	return a.mirror.StreamAudio(a.ctx, capture, a.stream)
+}
+func (a *LegacyAudio) Close() {
+	a.once.Do(func() {
+		a.cancel()
+		a.conn.Close()
+		if a.stream != nil {
+			a.stream.Close()
+		}
+	})
+}
