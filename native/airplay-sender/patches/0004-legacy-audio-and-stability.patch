+func readRAOPTest(r *bufio.Reader) (string, map[string]string, []byte, error) {
+	line, e := r.ReadString('\n')
+	if e != nil {
+		return "", nil, nil, e
+	}
+	fields := strings.Fields(line)
+	if len(fields) != 3 {
+		return "", nil, nil, fmt.Errorf("invalid request")
+	}
+	h := map[string]string{}
+	for {
+		line, e = r.ReadString('\n')
+		if e != nil {
+			return "", nil, nil, e
+		}
+		if line == "\r\n" {
+			break
+		}
+		k, v, ok := strings.Cut(line, ":")
+		if !ok {
+			return "", nil, nil, fmt.Errorf("invalid header")
+		}
+		h[strings.ToLower(k)] = strings.TrimSpace(v)
+	}
+	n, _ := strconv.Atoi(h["content-length"])
+	b := make([]byte, n)
+	_, e = io.ReadFull(r, b)
+	return fields[0], h, b, e
+}
+func replyRAOPTest(c net.Conn, status int, headers string) {
+	fmt.Fprintf(c, "RTSP/1.0 %d Test\r\nContent-Length: 0\r\n%s\r\n", status, headers)
+}
