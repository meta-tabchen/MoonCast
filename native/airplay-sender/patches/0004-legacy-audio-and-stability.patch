+func TestLegacyLongStreamDisconnectAndReconnect(t *testing.T) {
+	seconds, _ := strconv.Atoi(os.Getenv("MOONCAST_LEGACY_SOAK_SECONDS"))
+	if seconds < 30 {
+		t.Skip("explicit >=30-second real-time soak required")
+	}
+	files := []string{os.Getenv("MOONCAST_LEGACY_FIXTURE"), os.Getenv("MOONCAST_LEGACY_LANDSCAPE"), os.Getenv("MOONCAST_LEGACY_PORTRAIT")}
+	var units [][][]byte
+	for _, file := range files {
+		b, e := os.ReadFile(file)
+		if e != nil {
+			t.Fatal(e)
+		}
+		u := legacyFixtureAUs(b)
+		if len(u) == 0 {
+			t.Fatal("empty fixture")
+		}
+		units = append(units, u)
+	}
+	output, err := os.Create(os.Getenv("MOONCAST_LEGACY_SOAK_OUTPUT"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer output.Close()
+	// A new socket and decoder state on reconnect must begin with config + IDR.
+	for session, duration := range []time.Duration{time.Duration(seconds) * time.Second, 1500 * time.Millisecond} {
+		l, e := net.Listen("tcp", "127.0.0.1:0")
+		if e != nil {
+			t.Fatal(e)
+		}
+		result := make(chan error, 1)
+		go func() {
+			c, e := l.Accept()
+			if e != nil {
+				result <- e
+				return
+			}
+			defer c.Close()
+			defer l.Close()
+			c.SetDeadline(time.Now().Add(duration + 8*time.Second))
+			r, e := acceptLegacyMirror(c)
+			if e != nil {
+				result <- e
+				return
+			}
+			started := time.Now()
+			var lastStamp uint64
+			var lastBeat time.Time
+			videos, beats, configs := 0, 0, 0
+			for time.Since(started) < duration {
+				var h [128]byte
+				if _, e = io.ReadFull(r, h[:]); e != nil {
+					result <- e
+					return
+				}
+				n := binary.LittleEndian.Uint32(h[:4])
+				kind := binary.LittleEndian.Uint16(h[4:6])
+				if n > 16*1024*1024 {
+					result <- fmt.Errorf("unbounded packet")
+					return
+				}
+				p := make([]byte, n)
+				if _, e = io.ReadFull(r, p); e != nil {
+					result <- e
+					return
+				}
+				if kind == 2 {
+					var want [128]byte
+					want[4], want[6] = 2, 30
+					if h != want || n != 0 {
+						result <- fmt.Errorf("noncanonical heartbeat")
+						return
+					}
+					if !lastBeat.IsZero() && time.Since(lastBeat) > 2500*time.Millisecond {
+						result <- fmt.Errorf("heartbeat stalled")
+						return
+					}
+					lastBeat = time.Now()
+					beats++
+					continue
+				}
+				stamp := binary.LittleEndian.Uint64(h[8:16])
+				if stamp < lastStamp {
+					result <- fmt.Errorf("clock moved backwards")
+					return
+				}
+				lastStamp = stamp
+				sw := math.Float32frombits(binary.LittleEndian.Uint32(h[40:44]))
+				sh := math.Float32frombits(binary.LittleEndian.Uint32(h[44:48]))
+				dw := math.Float32frombits(binary.LittleEndian.Uint32(h[56:60]))
+				dh := math.Float32frombits(binary.LittleEndian.Uint32(h[60:64]))
+				x := math.Float32frombits(binary.LittleEndian.Uint32(h[48:52]))
+				y := math.Float32frombits(binary.LittleEndian.Uint32(h[52:56]))
+				if sw < 16 || sh < 16 || dw < 16 || dh < 16 || x < 0 || y < 0 || math.Abs(float64(x*2+dw-1280)) > 0.01 || math.Abs(float64(y*2+dh-720)) > 0.01 {
+					result <- fmt.Errorf("invalid display rectangle %v %v %v %v %v %v", sw, sh, x, y, dw, dh)
+					return
+				}
+				switch kind {
+				case 1:
+					if sw != math.Float32frombits(binary.LittleEndian.Uint32(h[16:20])) || sh != math.Float32frombits(binary.LittleEndian.Uint32(h[20:24])) {
+						result <- fmt.Errorf("codec dimension mismatch")
+						return
+					}
+					off := 6
+					for group, count := 0, int(p[5]&31); group < 2; group++ {
+						for i := 0; i < count; i++ {
+							size := int(binary.BigEndian.Uint16(p[off : off+2]))
+							off += 2
+							output.Write([]byte{0, 0, 0, 1})
+							output.Write(p[off : off+size])
+							off += size
+						}
+						if group == 0 {
+							count = int(p[off])
+							off++
+						}
+					}
+					configs++
+				case 0:
+					if configs == 0 {
+						result <- fmt.Errorf("video before config")
+						return
+					}
+					for off := 0; off < len(p); {
+						size := int(binary.BigEndian.Uint32(p[off : off+4]))
+						off += 4
+						output.Write([]byte{0, 0, 0, 1})
+						output.Write(p[off : off+size])
+						off += size
+					}
+					videos++
+				default:
+					result <- fmt.Errorf("invalid packet type")
+					return
+				}
+			}
+			if videos < int(duration.Seconds()*15) || beats < int(duration.Seconds()*0.7) || configs < 1 {
+				result <- fmt.Errorf("stream starved: video=%d heartbeat=%d config=%d", videos, beats, configs)
+				return
+			}
+			if session == 0 && configs < 3 {
+				result <- fmt.Errorf("resolution changes not propagated")
+				return
+			}
+			t.Logf("session=%d duration=%v video=%d heartbeat=%d config=%d; closing receiver", session, duration, videos, beats, configs)
+			result <- nil
+		}()
+		ctx, cancel := context.WithCancel(context.Background())
+		m, e := tryLegacyHTTPPort(ctx, "127.0.0.1", l.Addr().(*net.TCPAddr).Port, "", 1280, 720, 20, 0)
+		if e != nil {
+			cancel()
+			t.Fatal(e)
+		}
+		failures := make(chan error, 8)
+		go m.Watch(ctx, func(e error) { failures <- e })
+		go m.Heartbeats(ctx, func(e error) { failures <- e })
+		tick := time.NewTicker(50 * time.Millisecond)
+		started := time.Now()
+		index := 0
+		resultRead := false
+		clockDone := make(chan error, 1)
+		go func() { clockDone <- checkLegacyClocks(m, duration) }()
+	sendLoop:
+		for {
+			select {
+			case e := <-result:
+				resultRead = true
+				if e != nil {
+					t.Error(e)
+				}
+				break sendLoop
+			case <-tick.C:
+				phase := int(time.Since(started)/(10*time.Second)) % len(units)
+				u := units[phase]
+				if phase != index/1000000 {
+					index = phase * 1000000
+				}
+				pos := index % 1000000
+				frame := u[pos%len(u)]
+				index++
+				if e = m.SendFrame(frame, pos%len(u) == 0); e != nil {
+					break sendLoop
+				}
+			}
+		}
+		tick.Stop()
+		if !resultRead {
+			if e = <-result; e != nil {
+				t.Fatal(e)
+			}
+		}
+		select {
+		case e := <-failures:
+			if e == nil {
+				t.Error("missing close reason")
+			}
+		case <-time.After(4 * time.Second):
+			t.Error("receiver close was not detected")
+		}
+		cancel()
+		m.Close()
+		if e = <-clockDone; e != nil {
+			t.Fatal(e)
+		}
+	}
+}
+
+func checkLegacyClocks(m *LegacyHTTPMirror, duration time.Duration) error {
+	peer, err := net.DialUDP("udp", nil, m.timing.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		return err
+	}
+	defer peer.Close()
+	until := time.Now().Add(duration - 300*time.Millisecond)
+	for time.Now().Before(until) {
+		peer.SetDeadline(time.Now().Add(time.Second))
+		req := make([]byte, 48)
+		req[0] = 0x23
+		copy(req[40:], []byte("clock123"))
+		peer.Write(req)
+		var b [64]byte
+		n, e := peer.Read(b[:])
+		if e != nil {
+			return e
+		}
+		if n != 48 || b[0] != 0x24 || !bytes.Equal(b[24:32], req[40:48]) {
+			return fmt.Errorf("invalid NTP48")
+		}
+		now := legacyTimestamp(time.Since(m.started))
+		recv := binary.BigEndian.Uint64(b[32:40])
+		if now < recv || now-recv > 1<<32 {
+			return fmt.Errorf("clock basis mismatch")
+		}
+		req = make([]byte, 32)
+		req[0], req[1] = 0x80, 0xd2
+		copy(req[24:], []byte("raoptime"))
+		peer.Write(req)
+		n, e = peer.Read(b[:])
+		if e != nil {
+			return e
+		}
+		if n != 32 || b[1] != 0xd3 || !bytes.Equal(b[8:16], req[24:32]) {
+			return fmt.Errorf("invalid RAOP timing32")
+		}
+		time.Sleep(250 * time.Millisecond)
+	}
+	return nil
+}
