+package airplay
+
+// Independent implementation of the public legacy HTTP mirroring wire format.
+// Protocol reference: https://nto.github.io/AirPlay.html#screenmirroring
+// No proprietary sender implementation or credentials are incorporated.
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"howett.net/plist"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+var ErrLegacyHTTPUnavailable = errors.New("legacy HTTP mirroring not advertised by stream.xml")
+
+type LegacyHTTPMirror struct {
+	client           *AirPlayClient
+	reader           *bufio.Reader
+	password         string
+	deviceID         uint64
+	started          time.Time
+	mu               sync.Mutex
+	closeOnce        sync.Once
+	closed           chan struct{}
+	timing           *net.UDPConn
+	crypt            cipher.Stream
+	sps, pps, config []byte
+	awaitingIDR      bool
+	lastClose        bool
+	Width, Height    int
+}
+
+// TryLegacyHTTP probes only the explicitly selected numeric LAN receiver, at
+// its single documented legacy port. It never scans hosts or follows redirects.
+func TryLegacyHTTP(ctx context.Context, host, pin string, width, height, fps int) (*LegacyHTTPMirror, error) {
+	return tryLegacyHTTPPort(ctx, host, 7100, pin, width, height, fps, 7010)
+}
+
+func tryLegacyHTTPPort(ctx context.Context, host string, port int, pin string, width, height, fps, timingPort int) (*LegacyHTTPMirror, error) {
+	ip := net.ParseIP(strings.Split(host, "%")[0])
+	if ip == nil || !(ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast()) {
+		return nil, ErrLegacyHTTPUnavailable
+	}
+	probeCtx, cancel := context.WithTimeout(ctx, 2500*time.Millisecond)
+	defer cancel()
+	// A short dial timeout bounds the extra probe for modern-only receivers.
+	conn, err := (&net.Dialer{Timeout: 600 * time.Millisecond}).DialContext(probeCtx, "tcp", net.JoinHostPort(host, strconv.Itoa(port)))
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, ErrLegacyHTTPUnavailable
+	}
+	client := NewAirPlayClient(host, port)
+	client.conn = conn
+	closeConn := conn
+	context.AfterFunc(ctx, func() { closeConn.Close() })
+	m := &LegacyHTTPMirror{client: client, reader: bufio.NewReaderSize(conn, 4096), password: pin, started: time.Now(), closed: make(chan struct{})}
+	keep := false
+	defer func() {
+		if !keep {
+			m.Close()
+		}
+	}()
+	conn.SetDeadline(time.Now().Add(2 * time.Second))
+	var id [8]byte
+	if _, err = rand.Read(id[:]); err != nil {
+		return nil, err
+	}
+	m.deviceID = binary.BigEndian.Uint64(id[:])&0x0000ffffffffffff | 0x020000000000
+	body, headers, err := m.request("GET", "/stream.xml", "", nil, nil)
+	if err != nil {
+		if errors.Is(err, ErrAirPlay1PasswordRequired) {
+			return nil, err
+		}
+		var status *HTTPStatusError
+		if errors.As(err, &status) && (status.StatusCode == 401 || status.StatusCode == 403 || status.StatusCode == 470) {
+			return nil, fmt.Errorf("legacy GET/stream.xml: %w", err)
+		}
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, ErrLegacyHTTPUnavailable
+	}
+	var caps map[string]interface{}
+	if _, err = plist.Unmarshal(body, &caps); err != nil {
+		return nil, ErrLegacyHTTPUnavailable
+	}
+	w, h := plistInt(caps["width"]), plistInt(caps["height"])
+	version, ok := caps["version"].(string)
+	if !ok || !validLegacyVersion(version) || len(version) > 64 || w < 16 || h < 16 || w > 8192 || h > 8192 {
+		return nil, ErrLegacyHTTPUnavailable
+	}
+	for _, k := range []string{"passwordRequired", "requiresAuthentication", "pw"} {
+		if caps[k] == true && pin == "" {
+			return nil, ErrAirPlay1PasswordRequired
+		}
+	}
+	if strings.EqualFold(headers["connection"], "close") {
+		conn.Close()
+		conn, err = (&net.Dialer{Timeout: time.Second}).DialContext(ctx, "tcp", net.JoinHostPort(host, strconv.Itoa(port)))
+		if err != nil {
+			return nil, fmt.Errorf("legacy reconnect: %w", err)
+		}
+		client.conn = conn
+		m.reader = bufio.NewReaderSize(conn, 4096)
+		nextConn := conn
+		context.AfterFunc(ctx, func() { nextConn.Close() })
+	}
+	// Reuse the existing reviewed FairPlay primitive with HTTP transport. Only
+	// an explicitly unsupported endpoint permits optional plaintext mirroring.
+	client.requestOverride = func(method, path, ct string, b []byte, extra ...map[string]string) ([]byte, error) {
+		hdr := map[string]string{}
+		for _, x := range extra {
+			for k, v := range x {
+				hdr[k] = v
+			}
+		}
+		data, _, e := m.request(method, path, ct, b, hdr)
+		return data, e
+	}
+	client.infoUnavailable = true
+	err = client.FairPlaySetup(ctx)
+	if err != nil {
+		var status *HTTPStatusError
+		unsupported := errors.Is(err, ErrFairPlayUnsupported) || (errors.As(err, &status) && (status.StatusCode == 404 || status.StatusCode == 405 || status.StatusCode == 501))
+		if !unsupported {
+			return nil, fmt.Errorf("legacy POST/fp-setup: %w", err)
+		}
+		if caps["requiresEncryption"] == true || caps["encryptionRequired"] == true {
+			return nil, fmt.Errorf("legacy POST/fp-setup: required encryption unavailable")
+		}
+	}
+	if m.lastClose {
+		if client.FpEkey != nil {
+			return nil, fmt.Errorf("legacy encrypted control connection closed")
+		}
+		client.Close()
+		next, e := (&net.Dialer{Timeout: time.Second}).DialContext(ctx, "tcp", net.JoinHostPort(host, strconv.Itoa(port)))
+		if e != nil {
+			return nil, fmt.Errorf("legacy reconnect: %w", e)
+		}
+		client.conn = next
+		m.reader = bufio.NewReaderSize(next, 4096)
+		context.AfterFunc(ctx, func() { next.Close() })
+	}
+	width, height = legacySize(width, height, w, h)
+	m.Width, m.Height = width, height
+	localIP := client.conn.LocalAddr().(*net.TCPAddr).IP
+	m.timing, err = net.ListenUDP("udp", &net.UDPAddr{IP: localIP, Port: timingPort})
+	if err != nil {
+		return nil, fmt.Errorf("legacy timing bind: %w", err)
+	}
+	go m.serveTiming(ctx, ip)
+	fps = max(1, min(fps, 30))
+	names := func(values ...string) []interface{} {
+		out := []interface{}{}
+		for _, v := range values {
+			out = append(out, map[string]interface{}{"name": v})
+		}
+		return out
+	}
+	var sid [4]byte
+	if _, err = rand.Read(sid[:]); err != nil {
+		return nil, err
+	}
+	setup := map[string]interface{}{"deviceID": m.deviceID, "sessionID": int64(int32(binary.BigEndian.Uint32(sid[:]))), "latencyMs": int64(50), "version": "150.33", "fpsInfo": names("SubS", "B4En", "EnDp", "IdEn", "IdDp", "EQDp", "QueF", "Sent"), "timestampInfo": names("SubSu", "BePxT", "AfPxT", "BefEn", "EmEnc", "QueFr", "SndFr")}
+	if client.FpEkey != nil {
+		if len(client.fpAesKey) != 16 || len(client.fpIV) != 16 {
+			return nil, fmt.Errorf("legacy encryption parameters invalid")
+		}
+		setup["param1"] = client.FpEkey
+		setup["param2"] = client.fpIV
+		block, e := aes.NewCipher(client.fpAesKey)
+		if e != nil {
+			return nil, e
+		}
+		m.crypt = cipher.NewCTR(block, client.fpIV)
+	}
+	payload, err := plist.Marshal(setup, plist.BinaryFormat)
+	if err != nil {
+		return nil, err
+	}
+	// The public protocol upgrades here with no mandatory HTTP response. Capture
+	// remote rejections in Watch; never parse an HTTP error as media success.
+	if err = m.startStream(payload); err != nil {
+		return nil, fmt.Errorf("legacy POST/stream: %w", err)
+	}
+	client.conn.SetDeadline(time.Time{})
+	context.AfterFunc(ctx, m.Close)
+	keep = true
+	return m, nil
+}
+
+func legacySize(w, h, rw, rh int) (int, int) {
+	if w <= 0 || h <= 0 {
+		w, h = rw, rh
+	}
+	if h > w {
+		w, h = h, w
+	}
+	if w > 1280 {
+		h = h * 1280 / w
+		w = 1280
+	}
+	if h > 720 {
+		w = w * 720 / h
+		h = 720
+	}
+	return max(16, w&^1), max(16, h&^1)
+}
+
+func (m *LegacyHTTPMirror) writeRequest(method, path, ct string, body []byte, headers map[string]string) error {
+	var b bytes.Buffer
+	fmt.Fprintf(&b, "%s %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: AirPlay/150.33\r\nX-Apple-Device-ID: 0x%012x\r\nContent-Length: %d\r\n", method, path, net.JoinHostPort(m.client.host, strconv.Itoa(m.client.port)), m.deviceID, len(body))
+	if ct != "" {
+		fmt.Fprintf(&b, "Content-Type: %s\r\n", ct)
+	}
+	for k, v := range headers {
+		if strings.ContainsAny(k+v, "\r\n") {
+			return fmt.Errorf("invalid legacy request header")
+		}
+		fmt.Fprintf(&b, "%s: %s\r\n", k, v)
+	}
+	b.WriteString("\r\n")
+	b.Write(body)
+	m.client.conn.SetWriteDeadline(time.Now().Add(3 * time.Second))
+	return writeLegacyAll(m.client.conn, b.Bytes())
+}
+
+func (m *LegacyHTTPMirror) request(method, path, ct string, body []byte, headers map[string]string) ([]byte, map[string]string, error) {
+	if err := m.writeRequest(method, path, ct, body, headers); err != nil {
+		return nil, nil, err
+	}
+	m.client.conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	response, err := http.ReadResponse(m.reader, &http.Request{Method: method})
+	if err != nil {
+		return nil, nil, err
+	}
+	defer response.Body.Close()
+	if response.ContentLength > 65536 {
+		return nil, nil, fmt.Errorf("legacy response too large")
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, 65537))
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(data) > 65536 {
+		return nil, nil, fmt.Errorf("legacy response too large")
+	}
+	m.lastClose = response.Close
+	hdr := map[string]string{}
+	if response.Close {
+		hdr["connection"] = "close"
+	}
+	for k, v := range response.Header {
+		hdr[strings.ToLower(k)] = strings.Join(v, ",")
+	}
+	if response.StatusCode == 401 && headers["Authorization"] == "" {
+		if m.password == "" {
+			return nil, hdr, ErrAirPlay1PasswordRequired
+		}
+		challenge := hdr["www-authenticate"]
+		params := parseDigestParams(challenge)
+		if a := params["algorithm"]; a != "" && !strings.EqualFold(a, "MD5") {
+			return nil, hdr, fmt.Errorf("legacy unsupported digest algorithm")
+		}
+		if q := params["qop"]; q != "" {
+			found := false
+			for _, x := range strings.Split(q, ",") {
+				if strings.TrimSpace(x) == "auth" {
+					found = true
+				}
+			}
+			if !found {
+				return nil, hdr, fmt.Errorf("legacy unsupported digest qop")
+			}
+			challenge = strings.Replace(challenge, q, "auth", 1)
+		}
+		auth, e := buildDigestAuth(challenge, method, path, m.password)
+		if e != nil {
+			return nil, hdr, fmt.Errorf("legacy digest challenge invalid")
+		}
+		retry := map[string]string{"Authorization": auth}
+		for k, v := range headers {
+			retry[k] = v
+		}
+		return m.request(method, path, ct, body, retry)
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return nil, hdr, &HTTPStatusError{StatusCode: response.StatusCode}
+	}
+	return data, hdr, nil
+}
+
+func (m *LegacyHTTPMirror) Watch(ctx context.Context, report func(error)) {
+	for {
+		response, err := http.ReadResponse(m.reader, &http.Request{Method: "POST"})
+		if err == nil {
+			io.Copy(io.Discard, io.LimitReader(response.Body, 65537))
+			response.Body.Close()
+			if response.StatusCode < 200 || response.StatusCode >= 300 {
+				err = fmt.Errorf("legacy POST/stream: HTTP %d", response.StatusCode)
+			}
+		}
+		if err != nil {
+			select {
+			case <-ctx.Done():
+				return
+			case <-m.closed:
+				return
+			default:
+			}
+			m.Close()
+			report(fmt.Errorf("legacy POST/stream: %w", err))
+			return
+		}
+	}
+}
+
+func writeLegacyAll(w io.Writer, b []byte) error {
+	for len(b) > 0 {
+		n, err := w.Write(b)
+		if err != nil {
+			return err
+		}
+		if n <= 0 {
+			return io.ErrShortWrite
+		}
+		b = b[n:]
+	}
+	return nil
+}
+
+// Many legacy receivers switch straight to media without replying. A bounded
+// peek preserves that behavior while handling an actual HTTP challenge/error
+// before the encoder is allowed to send any frame.
+func (m *LegacyHTTPMirror) startStream(payload []byte) error {
+	var auth map[string]string
+	for attempt := 0; attempt < 2; attempt++ {
+		if err := m.writeRequest("POST", "/stream", "application/x-apple-binary-plist", payload, auth); err != nil {
+			return err
+		}
+		m.client.conn.SetReadDeadline(time.Now().Add(250 * time.Millisecond))
+		prefix, err := m.reader.Peek(5)
+		if err != nil {
+			var timeout net.Error
+			if errors.As(err, &timeout) && timeout.Timeout() && m.reader.Buffered() == 0 {
+				m.client.conn.SetReadDeadline(time.Time{})
+				return nil
+			}
+			return err
+		}
+		if string(prefix) != "HTTP/" {
+			return fmt.Errorf("invalid legacy stream response")
+		}
+		m.client.conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+		response, err := http.ReadResponse(m.reader, &http.Request{Method: "POST"})
+		if err != nil {
+			return err
+		}
+		io.Copy(io.Discard, io.LimitReader(response.Body, 65537))
+		response.Body.Close()
+		if response.StatusCode == 401 && attempt == 0 {
+			if m.password == "" {
+				return ErrAirPlay1PasswordRequired
+			}
+			challenge := response.Header.Get("WWW-Authenticate")
+			params := parseDigestParams(challenge)
+			if a := params["algorithm"]; a != "" && !strings.EqualFold(a, "MD5") {
+				return fmt.Errorf("unsupported legacy stream authentication")
+			}
+			if q := params["qop"]; q != "" {
+				found := false
+				for _, x := range strings.Split(q, ",") {
+					found = found || strings.TrimSpace(x) == "auth"
+				}
+				if !found {
+					return fmt.Errorf("unsupported legacy stream authentication")
+				}
+				challenge = strings.Replace(challenge, q, "auth", 1)
+			}
+			value, e := buildDigestAuth(challenge, "POST", "/stream", m.password)
+			if e != nil {
+				return fmt.Errorf("invalid legacy stream authentication")
+			}
+			auth = map[string]string{"Authorization": value}
+			continue
+		}
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			return &HTTPStatusError{StatusCode: response.StatusCode}
+		}
+		m.client.conn.SetReadDeadline(time.Time{})
+		return nil
+	}
+	return ErrAirPlay1PasswordRequired
+}
+func legacyTimestamp(d time.Duration) uint64 {
+	return uint64(d/time.Second)<<32 | (uint64(d%time.Second)<<32)/uint64(time.Second)
+}
+func (m *LegacyHTTPMirror) packet(kind uint16, payload []byte) error {
+	var header [128]byte
+	binary.LittleEndian.PutUint32(header[:4], uint32(len(payload)))
+	binary.LittleEndian.PutUint16(header[4:6], kind)
+	flags := uint16(6)
+	if kind == 2 {
+		flags = 0x1e
+	}
+	binary.LittleEndian.PutUint16(header[6:8], flags)
+	binary.LittleEndian.PutUint64(header[8:16], legacyTimestamp(time.Since(m.started)))
+	m.client.conn.SetWriteDeadline(time.Now().Add(3 * time.Second))
+	if err := writeLegacyAll(m.client.conn, header[:]); err != nil {
+		return err
+	}
+	return writeLegacyAll(m.client.conn, payload)
+}
+
+// Each JNI call is a complete encoder access unit, including the final NAL.
+func (m *LegacyHTTPMirror) SendFrame(frame []byte, keyframe bool) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if len(frame) == 0 {
+		return nil
+	}
+	if len(frame) > 16*1024*1024 {
+		return fmt.Errorf("legacy frame too large")
+	}
+	var nalus [][]byte
+	start := findStartCode(frame, 0)
+	if start != 0 {
+		return fmt.Errorf("legacy expects complete Annex B access unit")
+	}
+	for start >= 0 {
+		offset := 3
+		if start+3 < len(frame) && frame[start+2] == 0 {
+			offset = 4
+		}
+		next := findStartCode(frame, start+offset)
+		end := len(frame)
+		if next >= 0 {
+			end = next
+		}
+		if end > start+offset {
+			nalus = append(nalus, frame[start+offset:end])
+		}
+		start = next
+	}
+	var video []byte
+	hasIDR := false
+	for _, n := range nalus {
+		switch n[0] & 31 {
+		case 7:
+			if len(n) < 4 || len(n) > 65535 {
+				return fmt.Errorf("legacy invalid SPS")
+			}
+			m.sps = append([]byte(nil), n...)
+		case 8:
+			if len(n) > 65535 {
+				return fmt.Errorf("legacy invalid PPS")
+			}
+			m.pps = append([]byte(nil), n...)
+		case 1, 5:
+			video = append(video, avccWrap(n)...)
+			hasIDR = hasIDR || n[0]&31 == 5
+		case 6:
+			video = append(video, avccWrap(n)...)
+		}
+	}
+	if len(m.sps) == 0 || len(m.pps) == 0 {
+		return nil
+	}
+	config := buildAVCCConfig(m.sps, m.pps)
+	config = config[:len(config)-4]
+	if !bytes.Equal(config, m.config) {
+		if err := m.packet(1, config); err != nil {
+			return err
+		}
+		m.config = append([]byte(nil), config...)
+		m.awaitingIDR = true
+	}
+	if len(video) == 0 || (m.awaitingIDR && !hasIDR) {
+		return nil
+	}
+	m.awaitingIDR = false
+	if m.crypt != nil {
+		m.crypt.XORKeyStream(video, video)
+	}
+	if err := m.packet(0, video); err != nil {
+		return fmt.Errorf("legacy video write: %w", err)
+	}
+	return nil
+}
+func (m *LegacyHTTPMirror) Heartbeats(ctx context.Context, report func(error)) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-m.closed:
+			return
+		case <-ticker.C:
+			m.mu.Lock()
+			err := m.packet(2, nil)
+			m.mu.Unlock()
+			if err != nil {
+				m.Close()
+				report(fmt.Errorf("legacy heartbeat: %w", err))
+				return
+			}
+		}
+	}
+}
+func (m *LegacyHTTPMirror) serveTiming(ctx context.Context, peer net.IP) {
+	var b [512]byte
+	for {
+		n, addr, err := m.timing.ReadFromUDP(b[:])
+		if err != nil {
+			return
+		}
+		if n < 48 || !addr.IP.Equal(peer) || b[0]&7 != 3 {
+			continue
+		}
+		var reply [48]byte
+		reply[0] = 0x24
+		reply[1] = 1
+		reply[2] = 2
+		reply[3] = 0xec
+		copy(reply[12:16], "AIRP")
+		copy(reply[24:32], b[40:48])
+		now := legacyTimestamp(time.Since(m.started))
+		binary.BigEndian.PutUint64(reply[32:40], now)
+		binary.BigEndian.PutUint64(reply[40:48], now)
+		m.timing.WriteToUDP(reply[:], addr)
+	}
+}
+func (m *LegacyHTTPMirror) Close() {
+	m.closeOnce.Do(func() {
+		close(m.closed)
+		m.client.Close()
+		if m.timing != nil {
+			m.timing.Close()
+		}
+	})
+}
+
+func validLegacyVersion(v string) bool {
+	p := strings.Split(v, ".")
+	if len(p) < 2 || len(p) > 3 {
+		return false
+	}
+	for _, x := range p {
+		if len(x) == 0 || len(x) > 4 {
+			return false
+		}
+		n, e := strconv.Atoi(x)
+		if e != nil || n < 0 {
+			return false
+		}
+	}
+	return true
+}
