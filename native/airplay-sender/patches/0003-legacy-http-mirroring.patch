+func TestLegacyHTTPRealVideoAndTiming(t *testing.T) {
+	fixture := os.Getenv("MOONCAST_LEGACY_FIXTURE")
+	if fixture == "" {
+		t.Skip("local generated H264 fixture required; no TV acceptance implied")
+	}
+	data, e := os.ReadFile(fixture)
+	if e != nil {
+		t.Fatal(e)
+	}
+	units := legacyFixtureAUs(data)
+	if len(units) != 20 {
+		t.Fatalf("fixture AU count %d", len(units))
+	}
+	l, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	done := make(chan error, 1)
+	output := make(chan []byte, 1)
+	go func() {
+		c, e := l.Accept()
+		if e != nil {
+			done <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(6 * time.Second))
+		r := bufio.NewReader(c)
+		req, _, e := legacyReadRequest(r)
+		if e != nil {
+			done <- e
+			return
+		}
+		if req.URL.Path != "/stream.xml" || req.Proto != "HTTP/1.1" {
+			done <- fmt.Errorf("invalid capability request")
+			return
+		}
+		legacyTestReply(c, 200, legacyCaps(), "")
+		req, _, e = legacyReadRequest(r)
+		if e != nil {
+			done <- e
+			return
+		}
+		if req.URL.Path != "/fp-setup" {
+			done <- fmt.Errorf("missing encryption negotiation")
+			return
+		}
+		legacyTestReply(c, 501, nil, "")
+		req, body, e := legacyReadRequest(r)
+		if e != nil {
+			done <- e
+			return
+		}
+		if req.Method != "POST" || req.URL.Path != "/stream" || req.Proto != "HTTP/1.1" || req.Header.Get("Content-Type") != "application/x-apple-binary-plist" || !bytes.HasPrefix(body, []byte("bplist00")) {
+			done <- fmt.Errorf("bad stream preamble")
+			return
+		}
+		var setup map[string]interface{}
+		if _, e = plist.Unmarshal(body, &setup); e != nil {
+			done <- e
+			return
+		}
+		for _, key := range []string{"deviceID", "sessionID", "latencyMs", "version", "fpsInfo", "timestampInfo"} {
+			if _, ok := setup[key]; !ok {
+				done <- fmt.Errorf("missing %s", key)
+				return
+			}
+		}
+		if setup["param1"] != nil || setup["param2"] != nil {
+			done <- fmt.Errorf("unexpected fabricated encryption key")
+			return
+		}
+		// No HTTP response: verify immediate stream upgrade on this same socket.
+		var decoded []byte
+		videos, configs, beats := 0, 0, 0
+		var last uint64
+		for videos < 20 || beats == 0 {
+			var header [128]byte
+			if _, e = io.ReadFull(r, header[:]); e != nil {
+				done <- e
+				return
+			}
+			n := binary.LittleEndian.Uint32(header[:4])
+			kind := binary.LittleEndian.Uint16(header[4:6])
+			stamp := binary.LittleEndian.Uint64(header[8:16])
+			if n > 2*1024*1024 || stamp < last || stamp>>32 > 10 {
+				done <- fmt.Errorf("invalid packet bound/timestamp")
+				return
+			}
+			last = stamp
+			payload := make([]byte, n)
+			if _, e = io.ReadFull(r, payload); e != nil {
+				done <- e
+				return
+			}
+			switch kind {
+			case 1:
+				if len(payload) < 11 || payload[0] != 1 || payload[4]&3 != 3 {
+					done <- fmt.Errorf("invalid AVCDecoderConfigurationRecord")
+					return
+				}
+				off := 6
+				count := int(payload[5] & 31)
+				for group := 0; group < 2; group++ {
+					for i := 0; i < count; i++ {
+						if off+2 > len(payload) {
+							done <- io.ErrUnexpectedEOF
+							return
+						}
+						size := int(binary.BigEndian.Uint16(payload[off : off+2]))
+						off += 2
+						if off+size > len(payload) {
+							done <- io.ErrUnexpectedEOF
+							return
+						}
+						decoded = append(decoded, 0, 0, 0, 1)
+						decoded = append(decoded, payload[off:off+size]...)
+						off += size
+					}
+					if group == 0 {
+						if off >= len(payload) {
+							done <- io.ErrUnexpectedEOF
+							return
+						}
+						count = int(payload[off])
+						off++
+					}
+				}
+				configs++
+			case 0:
+				if configs == 0 {
+					done <- fmt.Errorf("video before AVC config")
+					return
+				}
+				for off := 0; off < len(payload); {
+					if off+4 > len(payload) {
+						done <- io.ErrUnexpectedEOF
+						return
+					}
+					size := int(binary.BigEndian.Uint32(payload[off : off+4]))
+					off += 4
+					if size <= 0 || off+size > len(payload) {
+						done <- fmt.Errorf("invalid AVCC NAL length")
+						return
+					}
+					decoded = append(decoded, 0, 0, 0, 1)
+					decoded = append(decoded, payload[off:off+size]...)
+					off += size
+				}
+				videos++
+			case 2:
+				if n != 0 || binary.LittleEndian.Uint16(header[6:8]) != 0x1e {
+					done <- fmt.Errorf("bad heartbeat")
+					return
+				}
+				beats++
+			default:
+				done <- fmt.Errorf("unexpected packet type %d", kind)
+				return
+			}
+		}
+		output <- decoded
+		done <- nil
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+	defer cancel()
+	m, e := tryLegacyHTTPPort(ctx, "127.0.0.1", l.Addr().(*net.TCPAddr).Port, "", 1280, 720, 30, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer m.Close()
+	timing, e := net.DialUDP("udp", nil, m.timing.LocalAddr().(*net.UDPAddr))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer timing.Close()
+	timing.SetDeadline(time.Now().Add(time.Second))
+	request := make([]byte, 48)
+	request[0] = 0x23
+	copy(request[40:], []byte("fixture!"))
+	timing.Write(request)
+	reply := make([]byte, 48)
+	if n, e := timing.Read(reply); e != nil || n != 48 || reply[0] != 0x24 || !bytes.Equal(reply[24:32], request[40:48]) {
+		t.Fatalf("timing reply invalid n=%d err=%v", n, e)
+	}
+	go m.Heartbeats(ctx, func(e error) {})
+	for _, au := range units {
+		if e = m.SendFrame(au, true); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if e := <-done; e != nil {
+		t.Fatal(e)
+	}
+	decoded := <-output
+	if path := os.Getenv("MOONCAST_LEGACY_OUTPUT"); path != "" {
+		if e = os.WriteFile(path, decoded, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+}
