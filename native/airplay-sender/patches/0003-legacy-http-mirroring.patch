+func legacyReadRequest(r *bufio.Reader) (*http.Request, []byte, error) {
+	req, e := http.ReadRequest(r)
+	if e != nil {
+		return nil, nil, e
+	}
+	b, e := io.ReadAll(io.LimitReader(req.Body, 65537))
+	req.Body.Close()
+	return req, b, e
+}
