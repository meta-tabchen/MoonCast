+func TestLegacyProbeValidationAndAuthentication(t *testing.T) {
+	for _, scenario := range []string{"html", "redirect", "unsupported", "auth", "required-encryption", "post-denied"} {
+		t.Run(scenario, func(t *testing.T) {
+			l, e := net.Listen("tcp", "127.0.0.1:0")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer l.Close()
+			done := make(chan error, 1)
+			go func() {
+				c, e := l.Accept()
+				if e != nil {
+					done <- e
+					return
+				}
+				defer c.Close()
+				c.SetDeadline(time.Now().Add(4 * time.Second))
+				r := bufio.NewReader(c)
+				req, _, e := legacyReadRequest(r)
+				if e != nil {
+					done <- e
+					return
+				}
+				if req.Method != "GET" || req.URL.Path != "/stream.xml" || req.Proto != "HTTP/1.1" {
+					done <- fmt.Errorf("bad probe")
+					return
+				}
+				switch scenario {
+				case "html":
+					legacyTestReply(c, 200, []byte("<html>not a receiver</html>"), "")
+					done <- nil
+					return
+				case "redirect":
+					legacyTestReply(c, 302, nil, "Location: http://127.0.0.2/stream.xml\r\n")
+					done <- nil
+					return
+				case "unsupported":
+					legacyTestReply(c, 501, nil, "")
+					done <- nil
+					return
+				case "auth":
+					legacyTestReply(c, 401, nil, "WWW-Authenticate: Digest realm=\"receiver\", nonce=\"fixture\"\r\n")
+					done <- nil
+					return
+				}
+				caps := legacyCaps()
+				if scenario == "required-encryption" {
+					caps, _ = plist.Marshal(map[string]interface{}{"width": int64(1280), "height": int64(720), "version": "150.33", "requiresEncryption": true}, plist.XMLFormat)
+				}
+				legacyTestReply(c, 200, caps, "")
+				req, _, e = legacyReadRequest(r)
+				if e != nil {
+					done <- e
+					return
+				}
+				if req.URL.Path != "/fp-setup" || req.Proto != "HTTP/1.1" {
+					done <- fmt.Errorf("missing HTTP FairPlay negotiation")
+					return
+				}
+				legacyTestReply(c, 501, nil, "")
+				if scenario == "post-denied" {
+					req, _, e = legacyReadRequest(r)
+					if e != nil {
+						done <- e
+						return
+					}
+					if req.URL.Path != "/stream" {
+						done <- fmt.Errorf("missing stream POST")
+						return
+					}
+					legacyTestReply(c, 403, nil, "")
+				}
+				done <- nil
+			}()
+			ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+			defer cancel()
+			m, e := tryLegacyHTTPPort(ctx, "127.0.0.1", l.Addr().(*net.TCPAddr).Port, "", 1280, 720, 30, 0)
+			if m != nil {
+				m.Close()
+				t.Fatal("invalid/auth-denied receiver was selected")
+			}
+			switch scenario {
+			case "auth":
+				if !errors.Is(e, ErrAirPlay1PasswordRequired) {
+					t.Fatalf("PIN challenge lost: %v", e)
+				}
+			case "required-encryption", "post-denied":
+				if e == nil || errors.Is(e, ErrLegacyHTTPUnavailable) {
+					t.Fatalf("required security/error was downgraded: %v", e)
+				}
+			default:
+				if !errors.Is(e, ErrLegacyHTTPUnavailable) {
+					t.Fatalf("bad probe should preserve modern path: %v", e)
+				}
+			}
+			if e := <-done; e != nil {
+				t.Fatal(e)
+			}
+		})
+	}
+}
