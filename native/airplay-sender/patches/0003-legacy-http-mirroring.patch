+func legacyFixtureAUs(data []byte) [][]byte {
+	var units [][]byte
+	var current []byte
+	for start := findStartCode(data, 0); start >= 0; {
+		n := 3
+		if start+3 < len(data) && data[start+2] == 0 {
+			n = 4
+		}
+		next := findStartCode(data, start+n)
+		end := len(data)
+		if next >= 0 {
+			end = next
+		}
+		if end > start+n {
+			if data[start+n]&31 == 9 && len(current) > 0 {
+				units = append(units, current)
+				current = nil
+			}
+			current = append(current, data[start:end]...)
+		}
+		start = next
+	}
+	if len(current) > 0 {
+		units = append(units, current)
+	}
+	return units
+}
