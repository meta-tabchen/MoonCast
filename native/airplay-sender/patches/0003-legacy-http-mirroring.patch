+func TestLegacyContinuousCTRAndCancellation(t *testing.T) {
+	key, iv := bytes.Repeat([]byte{0x21}, 16), bytes.Repeat([]byte{0x42}, 16)
+	block, _ := aes.NewCipher(key)
+	c, s := net.Pipe()
+	defer s.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: c}, started: time.Now(), closed: make(chan struct{}), crypt: cipher.NewCTR(block, iv)}
+	frame := []byte{0, 0, 0, 1, 0x67, 0x42, 0, 0x1e, 0, 0, 0, 1, 0x68, 1, 0, 0, 0, 1, 0x65, 0x88}
+	done := make(chan error, 1)
+	go func() {
+		decoder := cipher.NewCTR(block, iv)
+		frames := 0
+		for frames < 2 {
+			var h [128]byte
+			if _, e := io.ReadFull(s, h[:]); e != nil {
+				done <- e
+				return
+			}
+			b := make([]byte, binary.LittleEndian.Uint32(h[:4]))
+			if _, e := io.ReadFull(s, b); e != nil {
+				done <- e
+				return
+			}
+			if binary.LittleEndian.Uint16(h[4:6]) == 0 {
+				decoder.XORKeyStream(b, b)
+				if !bytes.Equal(b, avccWrap([]byte{0x65, 0x88})) {
+					done <- fmt.Errorf("CTR resets or payload corrupt")
+					return
+				}
+				frames++
+			}
+		}
+		done <- nil
+	}()
+	if e := m.SendFrame(frame, true); e != nil {
+		t.Fatal(e)
+	}
+	if e := m.SendFrame(frame, true); e != nil {
+		t.Fatal(e)
+	}
+	if e := <-done; e != nil {
+		t.Fatal(e)
+	}
+	blocked := make(chan error, 1)
+	go func() { blocked <- m.SendFrame(frame, true) }()
+	time.AfterFunc(30*time.Millisecond, m.Close)
+	select {
+	case e := <-blocked:
+		if e == nil {
+			t.Fatal("blocked writer not canceled")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not unblock writer")
+	}
+	if !strings.Contains(ErrLegacyHTTPUnavailable.Error(), "stream.xml") {
+		t.Fatal(ctx)
+	}
+}
