+package airplay
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+type legacyDiagnostics struct {
+	firstRect                                                                         atomic.Value
+	firstPTS                                                                          atomic.Int64
+	timingAlive                                                                       atomic.Bool
+	timingReadError                                                                   atomic.Value
+	video, config, heartbeat, bytes, ntp48rx, ntp48tx, ntp32rx, ntp32tx, timingErrors atomic.Int64
+	lastWrite, lastTiming, videoW, videoH, ptsDelta                                   atomic.Int64
+	audioStage, audioCaps, audioError                                                 atomic.Value
+	audioPackets                                                                      atomic.Int64
+}
+
+// Only structural error classes are exposed. Never receiver bodies, URLs,
+// addresses, authentication values, keys, device IDs, SDP or media bytes.
+func SafeTransportError(err error) string {
+	if err == nil {
+		return "none"
+	}
+	var status *HTTPStatusError
+	if errors.As(err, &status) {
+		return fmt.Sprintf("HTTP-%d", status.StatusCode)
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return "EOF"
+	}
+	var timeout net.Error
+	if errors.As(err, &timeout) && timeout.Timeout() {
+		return "TIMEOUT"
+	}
+	var errno syscall.Errno
+	if errors.As(err, &errno) {
+		return fmt.Sprintf("ERRNO-%d", int(errno))
+	}
+	if errors.Is(err, net.ErrClosed) {
+		return "CLOSED"
+	}
+	return "PROTOCOL"
+}
+func SafeFailureOrigin(err error) string {
+	if err == nil {
+		return "none"
+	}
+	text := err.Error()
+	switch {
+	case strings.HasPrefix(text, "legacy heartbeat:"):
+		return "heartbeat-write"
+	case strings.HasPrefix(text, "legacy config write:"):
+		return "codec-write"
+	case strings.HasPrefix(text, "legacy video write:"):
+		return "video-write"
+	case strings.HasPrefix(text, "legacy POST/stream:"):
+		return "stream-read"
+	default:
+		return "transport"
+	}
+}
+func diagValue(v *atomic.Value) string {
+	if x := v.Load(); x != nil {
+		return x.(string)
+	}
+	return "none"
+}
+func safeCapability(value string) string {
+	if len(value) > 64 {
+		return "invalid"
+	}
+	for _, c := range value {
+		if !(c >= '0' && c <= '9' || c == ',' || c == ' ') {
+			return "invalid"
+		}
+	}
+	if value == "" {
+		return "missing"
+	}
+	return value
+}
+func (m *LegacyHTTPMirror) AudioFailure(err error) {
+	if diagValue(&m.diag.audioStage) == "KEEPALIVE-FAILED" {
+		return
+	}
+	text := err.Error()
+	stage := "SETUP-FAILED"
+	for _, s := range []string{"discovery", "not advertised", "ALAC", "encryption", "OPTIONS", "FairPlay", "ANNOUNCE", "SETUP", "RECORD", "volume", "transport", "session"} {
+		if strings.Contains(text, s) {
+			stage = strings.ToUpper(strings.ReplaceAll(s, " ", "-"))
+			break
+		}
+	}
+	m.diag.audioStage.Store(stage)
+	m.diag.audioError.Store(SafeTransportError(err))
+}
+func (m *LegacyHTTPMirror) timestamp() uint64 {
+	if m.clock != nil {
+		return m.clock()
+	}
+	return legacyTimestamp(time.Since(m.started))
+}
+func (m *LegacyHTTPMirror) Statistics() string {
+	w, h := int(m.diag.videoW.Load()), int(m.diag.videoH.Load())
+	x, y, dw, dh := legacyDisplayRect(w, h, m.displayW, m.displayH)
+	kind := "session-relative"
+	if m.clock != nil {
+		kind = "android-monotonic"
+	}
+	var firstRect interface{}
+	if v := m.diag.firstRect.Load(); v != nil {
+		firstRect = v.([6]float32)
+	}
+	result := map[string]interface{}{"firstHeader40to60": firstRect, "firstPtsUs": m.diag.firstPTS.Load(), "ntpAlive": m.diag.timingAlive.Load(), "ntpReadError": diagValue(&m.diag.timingReadError), "transport": "legacy-http", "elapsedMs": time.Since(m.started).Milliseconds(), "clock": kind, "receiver": []int{m.displayW, m.displayH}, "requestedCanvas": []int{m.Width, m.Height}, "encoded": []int{w, h}, "header40to60": []float32{float32(w), float32(h), x, y, dw, dh}, "video": m.diag.video.Load(), "config": m.diag.config.Load(), "heartbeat": m.diag.heartbeat.Load(), "bytes": m.diag.bytes.Load(), "lastWriteMs": m.diag.lastWrite.Load(), "ntpBound": m.timing != nil, "ntp48rx": m.diag.ntp48rx.Load(), "ntp48tx": m.diag.ntp48tx.Load(), "ntp32rx": m.diag.ntp32rx.Load(), "ntp32tx": m.diag.ntp32tx.Load(), "timingErrors": m.diag.timingErrors.Load(), "lastTimingMs": m.diag.lastTiming.Load(), "ptsAgeMs": m.diag.ptsDelta.Load(), "audioStage": diagValue(&m.diag.audioStage), "audioCaps": diagValue(&m.diag.audioCaps), "audioError": diagValue(&m.diag.audioError), "audioPackets": m.diag.audioPackets.Load()}
+	b, _ := json.Marshal(result)
+	return string(b)
+}
