+func TestLegacyCapturePTSAndStructuralDiagnostics(t *testing.T) {
+	file := os.Getenv("MOONCAST_LEGACY_FIXTURE")
+	if file == "" {
+		t.Skip("H264 fixture required")
+	}
+	data, e := os.ReadFile(file)
+	if e != nil {
+		t.Fatal(e)
+	}
+	frame := legacyFixtureAUs(data)[0]
+	sender, receiver := net.Pipe()
+	defer receiver.Close()
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: sender}, closed: make(chan struct{}), started: time.Now(), Width: 1280, Height: 720, displayW: 1920, displayH: 1080, clock: func() uint64 { return 7000 << 32 }}
+	defer m.Close()
+	done := make(chan error, 1)
+	go func() {
+		for _, kind := range []uint16{1, 0} {
+			var h [128]byte
+			if _, e := io.ReadFull(receiver, h[:]); e != nil {
+				done <- e
+				return
+			}
+			if binary.LittleEndian.Uint16(h[4:6]) != kind || binary.LittleEndian.Uint16(h[6:8]) != 6 {
+				done <- fmt.Errorf("invalid header kind/flags")
+				return
+			}
+			want := legacyTimestamp(6999975 * time.Millisecond)
+			if binary.LittleEndian.Uint64(h[8:16]) != want {
+				done <- fmt.Errorf("encoder PTS was replaced by write time")
+				return
+			}
+			n := binary.LittleEndian.Uint32(h[:4])
+			p := make([]byte, n)
+			if _, e := io.ReadFull(receiver, p); e != nil {
+				done <- e
+				return
+			}
+		}
+		done <- nil
+	}()
+	if e = m.SendFrameAt(frame, true, 6999975000); e != nil {
+		t.Fatal(e)
+	}
+	if e = <-done; e != nil {
+		t.Fatal(e)
+	}
+	var stats map[string]interface{}
+	if e = json.Unmarshal([]byte(m.Statistics()), &stats); e != nil {
+		t.Fatal(e)
+	}
+	if stats["clock"] != "android-monotonic" || (stats["ptsAgeMs"].(float64) < 25 || stats["ptsAgeMs"].(float64) > 26) || stats["video"].(float64) != 1 || stats["config"].(float64) != 1 {
+		t.Fatalf("bad diagnostic counters: %v", stats)
+	}
+	if !bytes.Contains([]byte(m.Statistics()), []byte(`"firstHeader40to60":[128,72,0,0,1920,1080]`)) {
+		t.Fatal("first actual wire rectangle missing")
+	}
+	if !bytes.Contains([]byte(m.Statistics()), []byte(`"receiver":[1920,1080]`)) {
+		t.Fatal("receiver space lost")
+	}
+	for _, err := range []error{&HTTPStatusError{StatusCode: 403, Body: []byte("PIN secret address")}, fmt.Errorf("credential secret: %w", io.EOF)} {
+		s := SafeTransportError(err)
+		if bytes.Contains([]byte(s), []byte("secret")) {
+			t.Fatal("private error forwarded")
+		}
+	}
+	t.Log("actual encoder PTS retained; receiver/canvas/encoded spaces remain distinct; structural errors omit bodies")
+}
+
+func TestLegacySizeUsesReceiverCeilingWithoutChangingDisplaySpace(t *testing.T) {
+	for _, tc := range []struct{ rw, rh, w, h int }{{640, 360, 640, 360}, {800, 480, 800, 450}, {1920, 1080, 1280, 720}} {
+		w, h := legacySize(1920, 1080, tc.rw, tc.rh)
+		if w != tc.w || h != tc.h {
+			t.Fatalf("receiver %dx%d => canvas %dx%d", tc.rw, tc.rh, w, h)
+		}
+	}
+}
