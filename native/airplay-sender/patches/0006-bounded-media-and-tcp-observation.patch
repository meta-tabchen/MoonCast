+func TestLegacyActualSPSMetadata(t *testing.T) {
+	// Independent known SPS from the public MiraScreen sender's x264 output.
+	sps, _ := hex.DecodeString("6742c028da01e0089f961000000300100000030148f1832a")
+	s := legacySPSMetadata(sps)
+	if !s.Valid || s.Profile != 66 || s.Constraints != 192 || s.Level != 40 || s.Refs != 1 || s.FrameOnly != 1 || s.Chroma != 1 {
+		t.Fatalf("unexpected actual SPS: %+v", s)
+	}
+	for _, n := range [][]byte{nil, {0x67}, {0x67, 100, 0, 40}, {0x68, 66, 0, 40}, bytes.Repeat([]byte{0xff}, 65536)} {
+		if legacySPSMetadata(n).Valid {
+			t.Fatal("invalid SPS reported valid")
+		}
+	}
+}
+
+func TestLegacyAVCCShapeRejectsTruncationAndRetainsAllNALs(t *testing.T) {
+	p := append(avccWrap([]byte{0x06, 1, 2}), avccWrap([]byte{0x65, 3, 4})...)
+	p = append(p, avccWrap([]byte{0x65, 5, 6, 7})...)
+	mask, ok := legacyAVCCShape(p)
+	if !ok || mask != (1<<6|1<<5) {
+		t.Fatalf("missing multiple NALs: %x %v", mask, ok)
+	}
+	for _, bad := range [][]byte{nil, {0}, {0, 0, 0, 0}, {0xff, 0xff, 0xff, 0xff}, append(append([]byte(nil), p...), 0), p[:len(p)-1]} {
+		if _, ok := legacyAVCCShape(bad); ok {
+			t.Fatal("truncated/invalid length accepted")
+		}
+	}
+}
+
+func TestLegacyMediaTracePTSGapsBoundedHistoryAndNoPayload(t *testing.T) {
+	var tr legacyMediaTrace
+	secret := []byte("not-retained-payload-or-credentials")
+	for i := 0; i < 200; i++ {
+		pts := int64(i) * 50000
+		if i == 1 {
+			pts = -1
+		}
+		if i == 2 {
+			pts = -1
+		}
+		tr.input([][]byte{{0x41, 0xa0}, append([]byte{0x06}, secret...)}, false, false)
+		tr.sent(time.Duration(i)*4*time.Second, pts, 10, len(secret), 1<<1, true, i%3 == 0, time.Duration(i)*time.Microsecond)
+	}
+	s := tr.snapshot(800 * time.Second)
+	if s.Inputs != 200 || s.Sent != 200 || s.Dropped != 0 || s.BackwardsPTS != 1 || s.RepeatedPTS != 1 || s.LastPTSUs != 9950000 || s.MaxGapUs != 150001 || len(s.Buckets) != 30 || s.Buckets[0].Sec != 680 || s.Buckets[29].Sec != 796 || s.MaxWriteUs != 199 || s.MaxIDRGapMs != 12000 || s.LastIDRAgeMs != 8000 {
+		t.Fatalf("bad bounded history: %+v", s)
+	}
+	b, _ := json.Marshal(s)
+	if len(b) > 20000 || bytes.Contains(b, secret) {
+		t.Fatalf("unbounded/private diagnostics: %d bytes", len(b))
+	}
+	var fresh legacyMediaTrace
+	if f := fresh.snapshot(0); f.Generation != 0 || f.Sent != 0 || len(f.Buckets) != 0 || f.LastIDRAgeMs != -1 {
+		t.Fatal("state leaked across sessions")
+	}
+}
+
+func TestLegacyMediaTraceConcurrentSnapshots(t *testing.T) {
+	var tr legacyMediaTrace
+	done := make(chan bool)
+	go func() {
+		for i := 0; i < 10000; i++ {
+			tr.input([][]byte{{0x41, 0xa0}}, false, false)
+			tr.sent(time.Duration(i)*time.Millisecond, int64(i)*1000, 1, 4, 1<<1, true, false, 0)
+		}
+		close(done)
+	}()
+	for i := 0; i < 10000; i++ {
+		s := tr.snapshot(time.Second)
+		if len(s.Buckets) > 30 || s.Sent > s.Inputs {
+			t.Fatal("invalid concurrent snapshot")
+		}
+	}
+	<-done
+}
+
+func TestLegacyTCPHistoryBoundedAndExplicitlyUnknown(t *testing.T) {
+	var tr legacyMediaTrace
+	for i := 0; i < 200; i++ {
+		tr.socketSample(time.Duration(i)*4*time.Second, legacyTCPInfo{Available: true, State: 1, AckCounterKnown: true, BytesAcked: uint64(i) * 10000})
