+type legacyTraceConn struct{ bytes.Buffer }
+
+func (c *legacyTraceConn) Read(p []byte) (int, error)       { return 0, net.ErrClosed }
+func (c *legacyTraceConn) Write(p []byte) (int, error)      { return c.Buffer.Write(p[:min(len(p), 7)]) }
+func (c *legacyTraceConn) Close() error                     { return nil }
+func (c *legacyTraceConn) LocalAddr() net.Addr              { return nil }
+func (c *legacyTraceConn) RemoteAddr() net.Addr             { return nil }
+func (c *legacyTraceConn) SetDeadline(time.Time) error      { return nil }
+func (c *legacyTraceConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *legacyTraceConn) SetWriteDeadline(time.Time) error { return nil }
