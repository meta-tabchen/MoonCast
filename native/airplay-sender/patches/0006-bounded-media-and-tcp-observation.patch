+package airplay
+
+// Bounded, metadata-only observation of the existing sender. This does not
+// change configuration, timestamps, packet bytes, pacing, or reconnect policy.
+import (
+	"encoding/binary"
+	"sync"
+	"time"
+)
+
+type legacySPSInfo struct {
+	Valid       bool `json:"valid"`
+	Profile     uint `json:"profile"`
+	Constraints uint `json:"constraints"`
+	Level       uint `json:"level"`
+	ID          uint `json:"id"`
+	Chroma      uint `json:"chroma"`
+	Refs        uint `json:"refs"`
+	FrameOnly   uint `json:"frameOnly"`
+}
+
+// Parse actual SPS syntax through frame_mbs_only_flag. Bound every loop and
+// report unknown on malformed/unsupported syntax rather than guessing values.
+func legacySPSMetadata(sps []byte) (out legacySPSInfo) {
+	if len(sps) < 4 || len(sps) > 65535 || sps[0]&31 != 7 {
+		return
+	}
+	r := &h264BitReader{data: stripEmulationPrevention(sps[1:])}
+	out.Profile = r.readBits(8)
+	out.Constraints = r.readBits(8)
+	out.Level = r.readBits(8)
+	out.ID = r.readUE()
+	out.Chroma = 1
+	switch out.Profile {
+	case 100, 110, 122, 244, 44, 83, 86, 118, 128, 138, 139, 134, 135:
+		out.Chroma = r.readUE()
+		if out.Chroma > 3 {
+			return
+		}
+		if out.Chroma == 3 {
+			r.readBit()
+		}
+		r.readUE()
+		r.readUE()
+		r.readBit()
+		if r.readBit() == 1 {
+			count := 8
+			if out.Chroma == 3 {
+				count = 12
+			}
+			for i := 0; i < count; i++ {
+				if r.readBit() == 1 {
+					size := 16
+					if i >= 6 {
+						size = 64
+					}
+					last, next := 8, 8
+					for j := 0; j < size; j++ {
+						if next != 0 {
+							next = (last + r.readSE() + 256) % 256
+						}
+						if next != 0 {
+							last = next
+						}
+					}
+				}
+			}
+		}
+	case 66, 77, 88:
+	default:
+		return
+	}
+	r.readUE()
+	poc := r.readUE()
+	switch poc {
+	case 0:
+		r.readUE()
+	case 1:
+		r.readBit()
+		r.readSE()
+		r.readSE()
+		n := r.readUE()
+		if n > 255 {
+			return
+		}
+		for i := uint(0); i < n; i++ {
+			r.readSE()
+		}
+	case 2:
+	default:
+		return
+	}
+	out.Refs = r.readUE()
+	r.readBit()
+	r.readUE()
+	r.readUE()
+	out.FrameOnly = r.readBit()
+	out.Valid = !r.err && out.ID <= 31 && out.Refs <= 16
+	return
+}
+
+type legacyMediaBucket struct {
+	Sec        int64  `json:"sec"`
+	Frames     int64  `json:"frames"`
+	IDR        int64  `json:"idr"`
+	Bytes      int64  `json:"bytes"`
+	NALMask    uint32 `json:"nalMask"`
+	Generation int64  `json:"gen"`
+	MaxGapUs   int64  `json:"gapUs"`
+	Backwards  int64  `json:"ptsBack"`
+	MaxWriteUs int64  `json:"writeUs"`
+	MaxAgeMs   int64  `json:"ageMs"`
+	BadAVCC    int64  `json:"badAvcc"`
+}
+type legacyMediaSnapshot struct {
+	TCPHistory   []legacyTCPInfo     `json:"tcpFourSecondSamples"`
+	SPS          legacySPSInfo       `json:"sps"`
+	Generation   int64               `json:"generation"`
+	Inputs       int64               `json:"inputs"`
+	Sent         int64               `json:"sent"`
+	Dropped      int64               `json:"notSentInputs"`
+	IDR          int64               `json:"idr"`
+	LastIDRAgeMs int64               `json:"lastIdrAgeMs"`
+	MaxIDRGapMs  int64               `json:"maxIdrGapMs"`
+	KeyMismatch  int64               `json:"keyMismatch"`
+	BSlices      int64               `json:"bSlices"`
+	SliceErrors  int64               `json:"sliceErrors"`
+	BadAVCC      int64               `json:"badAvcc"`
+	RepeatedPTS  int64               `json:"repeatedPts"`
+	BackwardsPTS int64               `json:"backwardsPts"`
+	LastPTSUs    int64               `json:"lastPtsUs"`
+	MaxGapUs     int64               `json:"maxGapUs"`
+	MaxWriteUs   int64               `json:"maxWriteUs"`
+	MinAgeMs     int64               `json:"minAgeMs"`
+	MaxAgeMs     int64               `json:"maxAgeMs"`
+	Buckets      []legacyMediaBucket `json:"fourSecondBuckets"`
+}
+type legacyMediaTrace struct {
+	mu                sync.Mutex
+	s                 legacyMediaSnapshot
+	lastIDRMs         int64
+	buckets           [30]legacyMediaBucket
+	count, next       int
+	tcpSamples        [30]legacyTCPInfo
+	tcpCount, tcpNext int
+}
+
+func (t *legacyMediaTrace) input(nalus [][]byte, key, idr bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.s.Inputs++
+	if key != idr {
+		t.s.KeyMismatch++
+	}
+	for _, n := range nalus {
+		if len(n) == 0 || (n[0]&31 != 1 && n[0]&31 != 5) {
+			continue
+		}
+		// Only the first slice-header fields are needed. Never retain NAL data.
+		r := &h264BitReader{data: stripEmulationPrevention(n[1:min(len(n), 129)])}
+		r.readUE()
+		kind := r.readUE()
+		if r.err || kind > 9 {
+			t.s.SliceErrors++
+		} else if kind%5 == 1 {
+			t.s.BSlices++
+		}
+	}
+}
+func (t *legacyMediaTrace) configured(sps []byte) {
+	info := legacySPSMetadata(sps)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.s.SPS = info
+	t.s.Generation++
+}
+func legacyAVCCShape(payload []byte) (mask uint32, valid bool) {
+	if len(payload) == 0 {
+		return 0, false
+	}
+	for off := 0; off < len(payload); {
+		if len(payload)-off < 4 {
+			return mask, false
+		}
+		n := int64(binary.BigEndian.Uint32(payload[off : off+4]))
+		off += 4
+		if n < 1 || n > int64(len(payload)-off) {
+			return mask, false
+		}
+		mask |= uint32(1) << (payload[off] & 31)
+		off += int(n)
+	}
+	return mask, true
+}
+
+// All units/times here describe video packets successfully written to TCP.
+// A successful write is not an acknowledgement of receiver rendering.
+func (t *legacyMediaTrace) sent(elapsed time.Duration, pts, age int64, size int, mask uint32, valid, idr bool, write time.Duration) {
+	ms := elapsed.Milliseconds()
+	us := write.Microseconds()
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	s := &t.s
+	sec := ms / 4000 * 4
+	i := (t.next + len(t.buckets) - 1) % len(t.buckets)
+	if t.count == 0 || t.buckets[i].Sec != sec {
+		i = t.next
+		t.next = (t.next + 1) % len(t.buckets)
+		t.count = min(t.count+1, len(t.buckets))
+		t.buckets[i] = legacyMediaBucket{Sec: sec}
+	}
+	b := &t.buckets[i]
+	b.Frames++
+	b.Bytes += int64(size)
+	b.NALMask |= mask
+	b.Generation = s.Generation
+	if !valid {
+		s.BadAVCC++
+		b.BadAVCC++
+	}
+	if idr {
+		s.IDR++
+		b.IDR++
+		if s.IDR > 1 {
+			s.MaxIDRGapMs = traceMax(s.MaxIDRGapMs, ms-t.lastIDRMs)
+		}
+		t.lastIDRMs = ms
+	}
+	if s.Sent > 0 {
+		gap := pts - s.LastPTSUs
+		if gap < 0 {
+			s.BackwardsPTS++
+			b.Backwards++
+		} else if gap == 0 {
+			s.RepeatedPTS++
+		}
+		s.MaxGapUs = traceMax(s.MaxGapUs, gap)
+		b.MaxGapUs = traceMax(b.MaxGapUs, gap)
+	} else {
+		s.MinAgeMs = age
+		s.MaxAgeMs = age
+	}
+	s.Sent++
+	s.LastPTSUs = pts
+	s.MinAgeMs = traceMin(s.MinAgeMs, age)
+	s.MaxAgeMs = traceMax(s.MaxAgeMs, age)
+	s.MaxWriteUs = traceMax(s.MaxWriteUs, us)
+	b.MaxWriteUs = traceMax(b.MaxWriteUs, us)
+	b.MaxAgeMs = traceMax(b.MaxAgeMs, age)
+}
+func (t *legacyMediaTrace) snapshot(elapsed time.Duration) legacyMediaSnapshot {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	s := t.s
+	s.Dropped = s.Inputs - s.Sent
+	s.LastIDRAgeMs = -1
+	if s.IDR > 0 {
+		s.LastIDRAgeMs = elapsed.Milliseconds() - t.lastIDRMs
+	}
+	s.TCPHistory = make([]legacyTCPInfo, 0, t.tcpCount)
+	for j := 0; j < t.tcpCount; j++ {
+		s.TCPHistory = append(s.TCPHistory, t.tcpSamples[(t.tcpNext-t.tcpCount+len(t.tcpSamples)+j)%len(t.tcpSamples)])
+	}
+	s.Buckets = make([]legacyMediaBucket, 0, t.count)
+	for j := 0; j < t.count; j++ {
+		s.Buckets = append(s.Buckets, t.buckets[(t.next-t.count+len(t.buckets)+j)%len(t.buckets)])
+	}
+	return s
+}
+
+func traceMax(a, b int64) int64 {
+	if a > b {
+		return a
+	}
+	return b
+}
+func traceMin(a, b int64) int64 {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func (t *legacyMediaTrace) socketSample(elapsed time.Duration, info legacyTCPInfo) {
+	info.Sec = elapsed.Milliseconds() / 4000 * 4
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	i := (t.tcpNext + len(t.tcpSamples) - 1) % len(t.tcpSamples)
+	if t.tcpCount == 0 || t.tcpSamples[i].Sec != info.Sec {
+		i = t.tcpNext
+		t.tcpNext = (t.tcpNext + 1) % len(t.tcpSamples)
+		t.tcpCount = min(t.tcpCount+1, len(t.tcpSamples))
+	}
+	t.tcpSamples[i] = info
+}
