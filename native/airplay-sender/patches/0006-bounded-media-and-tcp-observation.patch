+func TestLegacyWireIdentityAndPartialWrites(t *testing.T) {
+	files := []string{os.Getenv("MOONCAST_LEGACY_FIXTURE"), os.Getenv("MOONCAST_LEGACY_LANDSCAPE"), os.Getenv("MOONCAST_LEGACY_PORTRAIT")}
+	if files[0] == "" {
+		t.Fatal("real encoder fixtures required")
+	}
+	c := &legacyTraceConn{}
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: c}, closed: make(chan struct{}), started: time.Now(), Width: 1280, Height: 720, displayW: 1280, displayH: 720, clock: func() uint64 { return 7000 << 32 }}
+	frames := 0
+	for _, file := range files {
+		b, e := os.ReadFile(file)
+		if e != nil {
+			t.Fatal(e)
+		}
+		units := legacyFixtureAUs(b)
+		for repeat := 0; repeat < 3; repeat++ {
+			for i, u := range units {
+				if e = m.SendFrameAt(u, i == 0, 6999000000+int64(frames)*50000); e != nil {
+					t.Fatal(e)
+				}
+				frames++
+				if frames%7 == 0 {
+					m.mu.Lock()
+					e = m.packet(2, nil)
+					m.mu.Unlock()
+					if e != nil {
+						t.Fatal(e)
+					}
+				}
+			}
+		}
+	}
+	data := c.Bytes()
+	sum := fmt.Sprintf("%x", sha256.Sum256(data))
+	t.Logf("wire_bytes=%d input_frames=%d sha256=%s", len(data), frames, sum)
+	if dest := os.Getenv("MOONCAST_WIRE_IDENTITY_SHA"); dest != "" {
+		if e := os.WriteFile(dest, []byte(sum+"\n"), 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+}
+
+func TestLegacyConcurrentHeartbeatVideoPacketBoundaries(t *testing.T) {
+	file := os.Getenv("MOONCAST_LEGACY_FIXTURE")
+	b, e := os.ReadFile(file)
+	if e != nil {
+		t.Fatal(e)
+	}
+	frame := legacyFixtureAUs(b)[0]
+	c := &legacyTraceConn{}
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: c}, closed: make(chan struct{}), started: time.Now(), Width: 1280, Height: 720, displayW: 1280, displayH: 720}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 200; i++ {
+			if err := m.SendFrameAt(frame, true, int64(i+1)*50000); err != nil {
+				t.Error(err)
+				return
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			m.mu.Lock()
+			err := m.packet(2, nil)
+			m.mu.Unlock()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+		}
+	}()
+	wg.Wait()
+	p := c.Bytes()
+	video, config, beats := 0, 0, 0
+	for off := 0; off < len(p); {
+		if len(p)-off < 128 {
+			t.Fatal("header split/interleaved")
+		}
+		h := p[off : off+128]
+		off += 128
+		n := int(binary.LittleEndian.Uint32(h[:4]))
+		kind := binary.LittleEndian.Uint16(h[4:6])
+		if n > len(p)-off {
+			t.Fatal("payload split/interleaved")
+		}
+		switch kind {
+		case 0:
+			for pos := 0; pos < n; {
+				if n-pos < 4 {
+					t.Fatal("NAL header cut")
+				}
+				size := int(binary.BigEndian.Uint32(p[off+pos : off+pos+4]))
+				pos += 4
+				if size < 1 || size > n-pos {
+					t.Fatal("NAL body cut")
+				}
+				pos += size
+			}
+			video++
+		case 1:
+			config++
+		case 2:
+			if n != 0 {
+				t.Fatal("heartbeat contains media")
+			}
+			beats++
+		default:
+			t.Fatal("unexpected type")
+		}
+		off += n
+	}
+	if video != 200 || config != 1 || beats != 100 {
+		t.Fatalf("packet counts %d %d %d", video, config, beats)
+	}
+}
