+package airplay
+
+// Kernel counters are evidence of TCP progress only, never decoded/displayed
+// frame acknowledgements. No packet contents or addresses are observed.
+type legacyTCPInfo struct {
+	Sec             int64  `json:"sec"`
+	Available       bool   `json:"available"`
+	State           uint8  `json:"state,omitempty"`
+	AckCounterKnown bool   `json:"ackCounterKnown,omitempty"`
+	BytesAcked      uint64 `json:"acked,omitempty"`
+	Unacked         uint32 `json:"unacked,omitempty"`
+	Retrans         uint32 `json:"retrans,omitempty"`
+	RTTUs           uint32 `json:"rttUs,omitempty"`
+}
--- /dev/null
+++ b/internal/airplay/legacy_tcp_info_linux.go
@@ -0,0 +1,38 @@
+//go:build linux
+
+package airplay
+
+import (
+	"golang.org/x/sys/unix"
+	"net"
+)
+
+func legacySocketInfo(conn net.Conn) (out legacyTCPInfo) {
+	tcp, ok := conn.(*net.TCPConn)
+	if !ok {
+		return
+	}
+	raw, err := tcp.SyscallConn()
+	if err != nil {
+		return
+	}
+	err = raw.Control(func(fd uintptr) {
+		info, e := unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+		if e != nil {
+			return
+		}
+		out.Available = true
+		out.State = info.State
+		out.BytesAcked = info.Bytes_acked
+		// Old kernels may return only the prefix of tcp_info. An absent extended
+		// byte counter is explicitly unknown, rather than proof of zero ACKs.
+		out.AckCounterKnown = info.Bytes_acked > 0
+		out.Unacked = info.Unacked
+		out.Retrans = info.Total_retrans
+		out.RTTUs = info.Rtt
+	})
+	if err != nil {
+		return legacyTCPInfo{}
+	}
+	return
+}
