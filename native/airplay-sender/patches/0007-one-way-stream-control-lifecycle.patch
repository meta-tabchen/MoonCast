+
+func TestLegacyTruncatedResponseStillFails(t *testing.T) {
+	for _, wire := range []string{"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabc", "HTTP/1.1 200 OK\r\nContent-Len", "HTTP/1.1 200 OK\r\n"} {
+		sender, peer := net.Pipe()
+		ctx, cancel := context.WithCancel(context.Background())
+		m := &LegacyHTTPMirror{client: &AirPlayClient{conn: sender}, reader: bufio.NewReader(sender), closed: make(chan struct{}), started: time.Now()}
+		failure := make(chan error, 1)
+		go m.Watch(ctx, func(e error) { failure <- e })
+		go func() { io.WriteString(peer, wire); peer.Close() }()
+		select {
+		case e := <-failure:
+			if e == nil || diagValue(&m.diag.controlState) != "failed" {
+				t.Fatalf("truncated response accepted/misclassified: %v", e)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("truncated response hidden as bare FIN")
+		}
+		cancel()
+		m.Close()
+		peer.Close()
+	}
+}
+
+func TestLegacyStreamRejectionDoesNotWaitForBody(t *testing.T) {
+	sender, peer := net.Pipe()
+	defer peer.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	m := &LegacyHTTPMirror{client: &AirPlayClient{conn: sender}, reader: bufio.NewReader(sender), closed: make(chan struct{}), started: time.Now()}
+	defer m.Close()
+	failure := make(chan error, 1)
+	go m.Watch(ctx, func(e error) { failure <- e })
+	go func() {
+		io.WriteString(peer, "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 64\r\n\r\n")
+		<-ctx.Done()
+	}()
+	select {
+	case e := <-failure:
+		if SafeTransportError(e) != "HTTP-503" {
+			t.Fatalf("wrong rejection: %v", e)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("HTTP rejection header hidden while waiting for body")
+	}
+}
+
+func TestLegacyTimingCountsIgnoredPeerPackets(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	sock, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &LegacyHTTPMirror{client: &AirPlayClient{}, timing: sock, closed: make(chan struct{}), started: time.Now()}
+	defer m.Close()
+	go m.serveTiming(ctx, net.IPv4(127, 0, 0, 1))
+	peer, err := net.DialUDP("udp", nil, sock.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	peer.SetDeadline(time.Now().Add(50 * time.Millisecond))
+	peer.Write([]byte{0x22, 0, 0, 0, 0})
+	var reply [64]byte
+	if _, err = peer.Read(reply[:]); err == nil {
+		t.Fatal("unsupported timing packet received a reply")
+	}
+	req := make([]byte, 48)
+	req[0] = 0x23
+	peer.SetDeadline(time.Now().Add(time.Second))
+	peer.Write(req)
+	if n, e := peer.Read(reply[:]); e != nil || n != 48 {
+		t.Fatalf("valid NTP failed: %d %v", n, e)
+	}
+	if m.diag.timingPeerPackets.Load() != 2 || m.diag.timingIgnored.Load() != 1 || m.diag.ntp48rx.Load() != 1 || m.diag.timingLastMode.Load() != 3 {
+		t.Fatal("ignored peer traffic indistinguishable from no traffic")
+	}
+}
+
+// A TCP FIN ends the peer's sending direction, not our sending direction.
+// This peer explicitly half-closes replies and keeps consuming media packets.
+func TestLegacyPeerReadHalfCloseKeepsReceivingVideo(t *testing.T) {
+	data, err := os.ReadFile(os.Getenv("MOONCAST_LEGACY_FIXTURE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	units := legacyFixtureAUs(data)
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	halfClosed := make(chan struct{})
+	result := make(chan error, 1)
+	go func() {
+		c, e := l.Accept()
+		if e != nil {
+			result <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(8 * time.Second))
+		r, e := acceptLegacyMirror(c)
+		if e != nil {
+			result <- e
+			return
+		}
+		video, beats := 0, 0
+		started := time.Now()
+		for time.Since(started) < 3*time.Second {
+			var h [128]byte
+			if _, e = io.ReadFull(r, h[:]); e != nil {
+				result <- fmt.Errorf("media closed while peer still receiving: %w", e)
+				return
+			}
+			n := binary.LittleEndian.Uint32(h[:4])
+			if n > 16*1024*1024 {
+				result <- fmt.Errorf("invalid packet length")
+				return
+			}
+			if _, e = io.CopyN(io.Discard, r, int64(n)); e != nil {
+				result <- e
+				return
+			}
+			switch binary.LittleEndian.Uint16(h[4:6]) {
+			case 0:
+				video++
+				if video == 1 {
+					if e = c.(*net.TCPConn).CloseWrite(); e != nil {
+						result <- e
+						return
+					}
+					close(halfClosed)
+				}
+			case 2:
+				beats++
+			}
+		}
+		if video < 40 || beats < 2 {
+			result <- fmt.Errorf("half-close starved media: video=%d beats=%d", video, beats)
+			return
+		}
+		t.Logf("peer sent FIN and continued receiving: video=%d heartbeat=%d", video, beats)
+		result <- nil
+	}()
+	m, err := tryLegacyHTTPPort(ctx, "127.0.0.1", l.Addr().(*net.TCPAddr).Port, "", 1280, 720, 20, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer m.Close()
+	failures := make(chan error, 8)
+	go m.Watch(ctx, func(e error) { failures <- e })
+	go m.Heartbeats(ctx, func(e error) { failures <- e })
+	tick := time.NewTicker(50 * time.Millisecond)
+	defer tick.Stop()
+	i := 0
+	for {
+		select {
+		case <-tick.C:
+			if e := m.SendFrame(units[i%len(units)], i%len(units) == 0); e != nil {
+				t.Fatalf("write after read-side FIN: %v", e)
+			}
+			i++
+		case e := <-failures:
+			t.Fatalf("read-side FIN incorrectly ended media: %v", e)
+		case e := <-result:
+			if e != nil {
+				t.Fatal(e)
+			}
+			select {
+			case <-halfClosed:
+			default:
+				t.Fatal("peer never half-closed")
+			}
+			return
+		case <-time.After(9 * time.Second):
+			t.Fatal("test did not finish")
+		}
+	}
+}
