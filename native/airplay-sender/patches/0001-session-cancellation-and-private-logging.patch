+func (s *Session) disconnect() {
+	s.mu.Lock()
+	s.epoch++
+	cancel, video, audio, capture, mirror := s.cancel, s.pipeW, s.audioW, s.audioCapture, s.mirror
+	s.cancel, s.pipeW, s.audioW, s.audioCapture, s.mirror, s.client = nil, nil, nil, nil, nil, nil
+	s.streamWidth, s.streamHeight = 0, 0
+	s.mu.Unlock()
+	// Cancel first: each control connection closes via its context callback, unblocking
+	// a handshake or TEARDOWN without reading a concurrently replaced client.conn.
+	if cancel != nil {
+		cancel()
+	}
+	if video != nil {
+		video.Close()
+	}
+	if audio != nil {
+		airplay.StopPipeAudioCapture(capture, audio)
+	}
+	if mirror != nil {
+		mirror.Close()
+	}
+}
